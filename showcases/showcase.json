{
  // One workbook, all thirteen code generators, output committed next to this file.
  //
  // This is a reading aid, not a gate. The regression suite already compiles all of
  // this - what it cannot do is let somebody see, side by side and in a diff, what the
  // eleven generators actually emit. That turns out to matter: the Unreal target shipped
  // for a while with the plain C++ reader inside it, and nothing in the suite could tell,
  // because every gate it had was still green. It was reading showcases/cpp/A.h next to
  // showcases/unreal that made it obvious.
  //
  // The reserved-words fixture on purpose. Its columns are named `class`, `delete`,
  // `operator`, `namespace`, `constructor`, `function` and `int`, so the output also
  // shows how each language gets out of the way of its own keywords - Kotlin's
  // backticks, Go's exported-name rewrite, Dart's renaming of a field that would shadow
  // a built-in type.
  //
  // Regenerate after changing a generator, a template or a reader, and review the diff:
  //
  //     dotnet run --project src/SheetMan.csproj -- --recipe showcases/showcase.json --silent
  //
  // Paths are relative to the repository root, which is where the CLI has to be run from.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/reserved-words",
        "FileExtensionPatterns": ".xlsx"
      }
    ]
  },

  // No binary export here. It is the runtime format and it is covered by the golden
  // tree; what it is not is reviewable - a .scb in a diff says nothing to anybody.
  "Exports": {
    "Json": [
      { "Path": "showcases/json", "UseCompactRowFormat": false, "Indented": true }
    ]
  },

  "Targets": [
    { "Type": "go", "Path": "showcases/go", "PackageName": "x", "ModulePath": "x", "WriteUpdater": true },
    { "Type": "rust", "Path": "showcases/rust", "CrateName": "x", "WriteUpdater": true },
    { "Type": "python", "Path": "showcases/python", "PackageName": "x", "WriteUpdater": true },
    { "Type": "java", "Path": "showcases/java", "PackageName": "x", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "kotlin", "Path": "showcases/kotlin", "PackageName": "x", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "ruby", "Path": "showcases/ruby", "ModuleName": "X", "AccessorName": "a", "WriteUpdater": true },
    { "Type": "dart", "Path": "showcases/dart", "AccessorName": "a", "WriteUpdater": true },
    { "Type": "unreal", "Path": "showcases/unreal", "ModuleName": "X", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "c", "Path": "showcases/c", "AccessorName": "A", "WriteUpdater": true },
    { "Type": "php", "Path": "showcases/php", "Namespace": "X", "AccessorName": "A", "WriteUpdater": true },

    // The document every other view renders from, in the same diff as the views.
    // `Author: none` because this file is committed: a name and an e-mail address
    // are personal data, and nothing here needs them.
    { "Type": "summary", "Path": "showcases/summary", "Author": "none" }
  ],

  "CodeGenerations": {
    "Cpp": [
      {
        "Path": "showcases/cpp",
        "Namespace": "x",
        "AccessorName": "A",
        "BinaryTableFileExtension": ".scb",
        "WriteUpdater": true
      }
    ],
    "CSharp": [
      { "Path": "showcases/csharp", "Namespace": "X", "AccessorName": "A", "WriteUpdater": true }
    ],
    "Typescript": [
      { "Path": "showcases/ts", "WriteUpdater": true }
    ],
    "Html": [
      { "Path": "showcases/html" }
    ]
  }
}
