<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>SheetMan</AssemblyName>
    <RootNamespace>SheetMan</RootNamespace>

    <!--
      NPOI 2.7+ warns on every build unless the OSMF licence is accepted explicitly.
    -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The LiteBinary readers, embedded so the generators can write them into their
      output. Each generated target is then self-contained: nothing to install, no
      include path to configure, and no chance of a consumer pairing generated code
      with a reader of a different vintage.

      One copy of each source, living under lib/ for anyone reading or editing it
      directly, so what ships cannot drift from what is committed.
    -->
    <EmbeddedResource Include="..\lib\ts\sheetman\lite_binary_reader.ts"
                      LogicalName="SheetMan.Runtime.Ts.lite_binary_reader.ts" />
    <EmbeddedResource Include="..\lib\cs\sheetman\LiteBinaryReader.cs"
                      LogicalName="SheetMan.Runtime.Cs.LiteBinaryReader.cs" />
    <EmbeddedResource Include="..\lib\cpp\sheetman\lite_binary_reader.h"
                      LogicalName="SheetMan.Runtime.Cpp.lite_binary_reader.h" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Code generation templates, embedded for the same reason as the readers: what ships
      cannot drift from what is committed, and a target cannot be pointed at a template of
      a different vintage.

      One file per generated language, flat, so a resource name has no directory
      separator in it.
    -->
    <EmbeddedResource Include="templates\*.sbn"
                      LogicalName="SheetMan.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <!--
      Scriban rather than Handlebars or Fluid: no dependencies of its own, and its `{{ }}`
      syntax does not collide with anything in the languages being generated - which
      matters, because a template for C++ is full of braces.
    -->
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.75.0.4178" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Database export targets. MySqlConnector rather than MySql.Data: it is fully
         async and MIT licensed. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Transitive pull-up, not something this project calls.

      NPOI drags in System.Security.Cryptography.Xml 8.0.2, which carries seven known
      high-severity advisories. A direct reference is the supported way to lift a
      transitive dependency onto a patched version; drop it once NPOI ships against
      a fixed one.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

</Project>
