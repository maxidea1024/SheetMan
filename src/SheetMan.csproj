<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>SheetMan</AssemblyName>
    <RootNamespace>SheetMan</RootNamespace>

    <!--
      NPOI 2.7+ warns on every build unless the OSMF licence is accepted explicitly.
    -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>

    <!--
      Debug information goes inside the assembly rather than beside it, so a published
      directory is the program and nothing else.
    -->
    <DebugType>embedded</DebugType>

    <!--
      Stops the .pdb and .xml files that ship inside packages from being copied out. One
      of them - SkiaSharp's, which arrives through NPOI - is 83 MB, more than the rest of
      a self-contained publish put together.
    -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <!--
      A self-contained publish is one file that runs on a machine with no .NET at all.
      That is what makes the ASP.NET Core framework reference below free: the serve mode
      needs that runtime, and a build machine that only has the base one would otherwise
      be unable to run SheetMan for any purpose.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The LiteBinary readers, embedded so the generators can write them into their
      output. Each generated target is then self-contained: nothing to install, no
      include path to configure, and no chance of a consumer pairing generated code
      with a reader of a different vintage.

      One copy of each source, living under lib/ for anyone reading or editing it
      directly, so what ships cannot drift from what is committed.
    -->
    <EmbeddedResource Include="..\lib\ts\sheetman\lite_binary_reader.ts"
                      LogicalName="SheetMan.Runtime.Ts.lite_binary_reader.ts" />
    <EmbeddedResource Include="..\lib\cs\sheetman\LiteBinaryReader.cs"
                      LogicalName="SheetMan.Runtime.Cs.LiteBinaryReader.cs" />
    <EmbeddedResource Include="..\lib\cs\sheetman\SheetManUpdater.cs"
                      LogicalName="SheetMan.Runtime.Cs.SheetManUpdater.cs" />
    <EmbeddedResource Include="..\lib\cpp\sheetman\lite_binary_reader.h"
                      LogicalName="SheetMan.Runtime.Cpp.lite_binary_reader.h" />
    <EmbeddedResource Include="..\lib\go\sheetman\lite_binary_reader.go"
                      LogicalName="SheetMan.Runtime.Go.lite_binary_reader.go" />
    <EmbeddedResource Include="..\lib\rust\sheetman\lite_binary_reader.rs"
                      LogicalName="SheetMan.Runtime.Rust.lite_binary_reader.rs" />
    <EmbeddedResource Include="..\lib\python\sheetman\lite_binary_reader.py"
                      LogicalName="SheetMan.Runtime.Python.lite_binary_reader.py" />
    <EmbeddedResource Include="..\lib\java\sheetman\LiteBinaryReader.java"
                      LogicalName="SheetMan.Runtime.Java.LiteBinaryReader.java" />
    <EmbeddedResource Include="..\lib\kotlin\sheetman\LiteBinaryReader.kt"
                      LogicalName="SheetMan.Runtime.Kotlin.LiteBinaryReader.kt" />
    <EmbeddedResource Include="..\lib\ruby\sheetman\lite_binary_reader.rb"
                      LogicalName="SheetMan.Runtime.Ruby.lite_binary_reader.rb" />
    <EmbeddedResource Include="..\lib\dart\sheetman\lite_binary_reader.dart"
                      LogicalName="SheetMan.Runtime.Dart.lite_binary_reader.dart" />
    <EmbeddedResource Include="..\lib\c\sheetman\sheetman_lite_binary_reader.h"
                      LogicalName="SheetMan.Runtime.C.sheetman_lite_binary_reader.h" />
    <EmbeddedResource Include="..\lib\php\sheetman\LiteBinaryReader.php"
                      LogicalName="SheetMan.Runtime.Php.LiteBinaryReader.php" />

    <!--
      Unreal gets its own rather than the C++ one, because the engine already has every
      type that reader defines. Going through std::string and a SheetMan Uuid struct
      cost two allocations per string cell and a text parse per uuid, to build what
      FString and FGuid already are. And an Unreal module builds with exceptions off, so
      the throwing reader could not report a malformed file at all - the throw was a
      termination inside a function whose signature promised a bool.
    -->
    <EmbeddedResource Include="..\lib\unreal\sheetman\SheetManLiteBinaryReader.h"
                      LogicalName="SheetMan.Runtime.Unreal.SheetManLiteBinaryReader.h" />
    <EmbeddedResource Include="..\lib\unreal\sheetman\SheetManUpdater.h"
                      LogicalName="SheetMan.Runtime.Unreal.SheetManUpdater.h" />
    <EmbeddedResource Include="..\lib\unreal\sheetman\SheetManUpdater.cpp"
                      LogicalName="SheetMan.Runtime.Unreal.SheetManUpdater.cpp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Starting recipes the `template` option writes, embedded so that `sheetman` produces the
      same file wherever it was installed from.
    -->
    <EmbeddedResource Include="recipes\*.jsonc"
                      LogicalName="SheetMan.Recipes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Code generation templates, embedded for the same reason as the readers: what ships
      cannot drift from what is committed, and a target cannot be pointed at a template of
      a different vintage.

      One file per generated language, flat, so a resource name has no directory
      separator in it.
    -->
    <EmbeddedResource Include="templates\*.sbn"
                      LogicalName="SheetMan.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The history page. Embedded for the same reason as everything else here, plus one of
      its own: the tool is expected to run on closed networks, so a page that fetches a
      stylesheet or a charting library from anywhere is a page that does not load.
    -->
    <EmbeddedResource Include="History\web\*"
                      LogicalName="SheetMan.Web.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The history's store is internal: it is infrastructure for the targets and the query
      layer in this assembly, not an API. The suite drives it directly all the same,
      because what has to be checked is how it behaves against a real MySQL - the
      migration, the upserts, the concurrent write - and reaching that only through a
      conversion would make each of those cases a workbook.
    -->
    <InternalsVisibleTo Include="SheetMan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The serve mode puts the history behind an HTTP API and a page. Kestrel rather than
      HttpListener: on Windows, binding HttpListener to anything but localhost needs a URL
      reservation or an elevated process, and a team tool that has to run as administrator
      to be reachable is a team tool nobody reaches.

      A framework reference rather than a package, so nothing new is restored. It does mean
      a framework-dependent deployment now needs the ASP.NET Core runtime rather than the
      base one; publish self-contained where that is not wanted.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <!--
      Scriban rather than Handlebars or Fluid: no dependencies of its own, and its `{{ }}`
      syntax does not collide with anything in the languages being generated - which
      matters, because a template for C++ is full of braces.
    -->
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.75.0.4178" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Database export targets. MySqlConnector rather than MySql.Data: it is fully
         async and MIT licensed. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <!--
    The System.Security.Cryptography.Xml pull-up that used to be here is gone. It existed
    to lift NPOI's transitive 8.0.2, which carries seven high-severity advisories, onto a
    patched version. The ASP.NET Core framework reference above now supplies that assembly
    from the shared framework, so the package reference is redundant - and NuGet says so,
    on standard output, in front of every `dotnet run`.

    If that framework reference is ever removed, put this back.
  -->

  <!--
    Native assets arrive with their own debug files, and those are neither reference-
    related nor ours - AllowedReferenceRelatedFileExtensions does not reach them. SkiaSharp's
    is 83 MB, which is more than everything else in a self-contained publish together.

    Safe to drop all of them: this project's own debug information is embedded in the
    assembly.
  -->
  <Target Name="DropNativeDebugFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
