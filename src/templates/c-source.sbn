#include <string.h>
{{~ for constant in constants ~}}
{{~ if constant.is_extern ~}}
const {{ constant.type }} {{ constant.name }} = {{ constant.value }};
{{~ end ~}}
{{~ end ~}}
{{~ for table in tables }}

static bool {{ table.function_prefix }}Parse({{ table.table_name }}* table, sm_reader* reader)
{
