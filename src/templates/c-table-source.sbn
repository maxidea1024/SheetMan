{{~## One table's implementation: parse, load, free and find. ##~}}
{{ include 'c-source-head.sbn' ~}}
static bool {{ table.function_prefix }}Parse({{ table.table_name }}* table, sm_reader* reader)
{
    int32_t row;

    if (!sm_read_table_header(reader, &table->count))
        return false;

    /* Every field encodes to at least one byte, so a row count larger than the
     * bytes left is one the exporter could not have written. Checked before the
     * allocation rather than discovered during it. */
    if (!sm_row_count_is_plausible(reader, table->count, {{ table.min_row_bytes }}))
        return sm_fail_with(reader, "the row count is larger than the file can hold");

    if (table->count > 0) {
        table->records = ({{ table.record_name }}*)sm_arena_alloc(
            &table->arena, (size_t)table->count * sizeof *table->records);

        table->by_index = (sm_index_entry*)sm_arena_alloc(
            &table->arena, (size_t)table->count * sizeof *table->by_index);

        if (table->records == NULL || table->by_index == NULL)
            return sm_fail_with(reader, "out of memory allocating the rows");
    }

    for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];
{{~ if table.fields | array.size == 0 }}

        (void)record;
{{~ end ~}}
{{~ for field in table.fields }}
{{~ if field.kind == 'var_array' }}

        {
            int32_t element_count = 0;
            int32_t element;

            (void)sm_read_counter32(reader, &element_count);

            /* The count came off the wire, and one element is at least one byte. */
            if (!sm_row_count_is_plausible(reader, element_count, 1))
                return sm_fail_with(reader, "an array is longer than the file can hold");

            record->{{ field.name }}_count = element_count;
            record->{{ field.name }} = ({{ field.element_type }}*)sm_arena_alloc(
                &table->arena, (size_t)element_count * sizeof *record->{{ field.name }});

            if (element_count > 0 && record->{{ field.name }} == NULL)
                return sm_fail_with(reader, "out of memory allocating an array");

            for (element = 0; element < element_count && !sm_failed(reader); ++element)
{{~ if field.needs_scratch ~}}
            {
                int32_t scratch = 0;
                (void)sm_read_enum(reader, &scratch);
                record->{{ field.name }}[element] = ({{ field.enum_type }})scratch;
            }
{{~ else ~}}
                (void){{ field.read_element }};
{{~ end ~}}
        }
{{~ else if field.kind == 'serial_ref' }}

        {
            int32_t element;

            for (element = 0; element < {{ field.element_count }}; ++element)
                (void)sm_read_int32(reader, &record->{{ field.name }}_index[element]);
        }
{{~ else if field.kind == 'serial' }}

        {
            int32_t element;

            for (element = 0; element < {{ field.element_count }}; ++element)
{{~ if field.needs_scratch ~}}
            {
                int32_t scratch = 0;
                (void)sm_read_enum(reader, &scratch);
                record->{{ field.name }}[element] = ({{ field.enum_type }})scratch;
            }
{{~ else ~}}
                (void){{ field.read_element }};
{{~ end ~}}
        }
{{~ else if field.kind == 'scalar_ref' ~}}
        (void)sm_read_int32(reader, &record->{{ field.name }}_index);
{{~ else if field.needs_scratch }}

        {
            int32_t scratch = 0;
            (void)sm_read_enum(reader, &scratch);
            record->{{ field.name }} = ({{ field.enum_type }})scratch;
        }
{{~ else ~}}
        (void){{ field.read_scalar }};
{{~ end ~}}
{{~ end }}

        table->by_index[row].key = record->{{ table.index_field }};
        table->by_index[row].position = row;
    }

    if (sm_failed(reader))
        return false;

    sm_index_sort(table->by_index, table->count);

    return true;
}

bool {{ table.function_prefix }}Load({{ table.table_name }}* table, const char* filename,
                                      char* error, size_t error_size)
{
    uint8_t* bytes = NULL;
    int32_t length = 0;
    sm_reader reader;
    bool ok;

    memset(table, 0, sizeof *table);

    if (!sm_read_all_bytes(filename, &bytes, &length)) {
        sm_copy_error(error, error_size, filename, "cannot be read");
        return false;
    }

    sm_reader_init(&reader, bytes, length, &table->arena);

    ok = {{ table.function_prefix }}Parse(table, &reader);

    if (!ok) {
        sm_copy_error(error, error_size, filename, sm_error(&reader));

        /* Nothing half-read is handed back: the arena goes and the table is empty
         * again, so a caller that ignores the return value still sees no rows. */
        {{ table.function_prefix }}Free(table);
    }

    /* The strings were copied into the arena, so the file buffer goes either way. */
    sm_free_bytes(bytes);

    return ok;
}

void {{ table.function_prefix }}Free({{ table.table_name }}* table)
{
    sm_arena_free(&table->arena);

    memset(table, 0, sizeof *table);
}

const {{ table.record_name }}* {{ table.function_prefix }}Find(
    const {{ table.table_name }}* table, int32_t index)
{
    int32_t position = sm_index_find(table->by_index, table->count, index);

    return position < 0 ? NULL : &table->records[position];
}
