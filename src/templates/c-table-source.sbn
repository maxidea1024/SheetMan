{{~## One table's implementation: parse, load, free and find. ##~}}
{{ include 'c-source-head.sbn' ~}}
static bool {{ table.function_prefix }}Parse({{ table.table_name }}* table, sm_reader* reader) {
  int32_t row;
  int32_t at;
  sm_column* columns = NULL;
  int32_t column_count = 0;

  if (!sm_read_table_header(reader, &table->count, &columns, &column_count))
    return false;

  if (table->count > 0) {
    table->records = ({{ table.record_name }}*)sm_arena_alloc(
      &table->arena, (size_t)table->count * sizeof *table->records);

    if (table->records == NULL)
      return sm_fail_with(reader, "out of memory allocating the rows");

{{~ for index in table.indexes ~}}
    table->{{ index.array_name }} = ({{ index.entry_type }}*)sm_arena_alloc(
      &table->arena, (size_t)table->count * sizeof *table->{{ index.array_name }});

    if (table->{{ index.array_name }} == NULL)
      return sm_fail_with(reader, "out of memory allocating the {{ index.field_name }} index");

{{~ end ~}}
  }

{{~ if table.has_string_fields }}
  /* The arena hands back zeroed memory, so every member starts at its zero - which for
   * a string is NULL, and NULL is what reaches printf when a column the file does not
   * carry is read. An empty string instead: a literal, so there is nothing to free and
   * nothing to allocate. */
  for (row = 0; row < table->count; ++row) {
    {{ table.record_name }}* record = &table->records[row];
{{~ for field in table.fields ~}}
{{~ if field.is_string ~}}
{{~ if field.kind == 'serial' }}
    {
      int32_t element;

      for (element = 0; element < {{ field.element_count }}; ++element)
        record->{{ field.name }}[element] = "";
    }
{{~ else if field.kind == 'scalar' }}
    record->{{ field.name }} = "";
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
  }

{{~ end ~}}
  /* Column by column, matched by tag rather than by position: a column this build has
   * no member for is skipped by its declared length, and one whose type no longer fits
   * the member stops the read naming the field. Rows arrive with every member at an
   * empty value, so one the file has nothing for keeps it. */
  for (at = 0; at < column_count && !sm_failed(reader); ++at) {
    const sm_column* column = &columns[at];
    int32_t block_end = reader->position + column->byte_length;

    switch (column->tag) {
{{~ for field in table.fields }}
    case {{ field.tag }}:
      {{ field.column_check }}
{{~ if field.kind == 'var_array' }}

      for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];
        int32_t element_count = 0;
        int32_t element;

        (void)sm_read_counter32(reader, &element_count);

        /* The count came off the wire, and one element is at least one byte. */
        if (!sm_row_count_is_plausible(reader, element_count, 1))
          return sm_fail_with(reader, "an array is longer than the file can hold");

        record->{{ field.name }}_count = element_count;
        record->{{ field.name }} = ({{ field.element_type }}*)sm_arena_alloc(
          &table->arena, (size_t)element_count * sizeof *record->{{ field.name }});

        if (element_count > 0 && record->{{ field.name }} == NULL)
          return sm_fail_with(reader, "out of memory allocating an array");

        for (element = 0; element < element_count && !sm_failed(reader); ++element)
{{~ if field.needs_scratch ~}}
        {
          int32_t scratch = 0;
          (void)sm_read_enum(reader, &scratch);
          record->{{ field.name }}[element] = ({{ field.enum_type }})scratch;
        }
{{~ else ~}}
          (void){{ field.read_element }};
{{~ end ~}}
      }
{{~ else if field.kind == 'serial_ref' }}

      for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];
        int32_t element;

        for (element = 0; element < {{ field.element_count }}; ++element)
          (void)sm_read_int32(reader, &record->{{ field.name }}_index[element]);
      }
{{~ else if field.kind == 'serial' }}

      for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];
        int32_t element;

        for (element = 0; element < {{ field.element_count }}; ++element)
{{~ if field.needs_scratch ~}}
        {
          int32_t scratch = 0;
          (void)sm_read_enum(reader, &scratch);
          record->{{ field.name }}[element] = ({{ field.enum_type }})scratch;
        }
{{~ else ~}}
          (void){{ field.read_element }};
{{~ end ~}}
      }
{{~ else if field.kind == 'scalar_ref' }}

      for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];

        (void)sm_read_int32(reader, &record->{{ field.name }}_index);
      }
{{~ else if field.needs_scratch }}

      for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];
        int32_t scratch = 0;

        (void)sm_read_enum(reader, &scratch);
        record->{{ field.name }} = ({{ field.enum_type }})scratch;
      }
{{~ else }}

      for (row = 0; row < table->count && !sm_failed(reader); ++row) {
        {{ table.record_name }}* record = &table->records[row];

        (void){{ field.read_scalar }};
      }
{{~ end }}
      break;
{{~ end }}
    default:
      /* A column this build has no member for: added to the schema after the code
       * was generated, or removed from the code while the data still carries it.
       * The block's declared length is the whole of what skipping needs to know. */
      (void)sm_skip(reader, column->byte_length);
      break;
    }

    if (!sm_check_block_end(reader, column, block_end))
      return false;
  }

  if (sm_failed(reader))
    return false;

  /* The keys can only be gathered once every column has been read: the column that
   * carries one arrives wherever the file happens to put it. */
  for (row = 0; row < table->count; ++row) {
{{~ for index in table.indexes ~}}
    table->{{ index.array_name }}[row].key = table->records[row].{{ index.member }};
    table->{{ index.array_name }}[row].position = row;
{{~ end ~}}
  }

{{~ for index in table.indexes ~}}
  {{ index.sort_call }}(table->{{ index.array_name }}, table->count);
{{~ end ~}}

  return true;
}

bool {{ table.function_prefix }}Load({{ table.table_name }}* table, const char* filename,
                   char* error, size_t error_size) {
  uint8_t* bytes = NULL;
  int32_t length = 0;
  sm_reader reader;
  bool ok;

  /* Loaded beside whatever the table is already holding, arena and all, and swapped in
   * only if it worked. That is what makes a reload safe: reading a patched file that
   * turns out to be truncated - or to carry a column this build cannot read - leaves the
   * rows the caller has pointers to exactly where they were.
   *
   * It also has to be this way round for the memory. The table owns its arena, and
   * zeroing the table before reading - which is what this did - dropped that arena
   * without freeing it, so every reload leaked the whole of the previous load. */
  {{ table.table_name }} loaded;

  memset(&loaded, 0, sizeof loaded);

  if (!sm_read_all_bytes(filename, &bytes, &length)) {
    sm_copy_error(error, error_size, filename, "cannot be read");
    return false;
  }

  sm_reader_init(&reader, bytes, length, &loaded.arena);

  ok = {{ table.function_prefix }}Parse(&loaded, &reader);

  if (ok) {
    /* The previous load goes now, and not before: its arena holds the strings and
     * arrays the caller was reading up to this line. */
    {{ table.function_prefix }}Free(table);
    *table = loaded;
  } else {
    sm_copy_error(error, error_size, filename, sm_error(&reader));

    /* Nothing half-read is kept, and the table is untouched. */
    {{ table.function_prefix }}Free(&loaded);
  }

  /* The strings were copied into the arena, so the file buffer goes either way. */
  sm_free_bytes(bytes);

  return ok;
}

void {{ table.function_prefix }}Free({{ table.table_name }}* table) {
  sm_arena_free(&table->arena);

  memset(table, 0, sizeof *table);
}
{{~ for index in table.indexes }}
const {{ table.record_name }}* {{ table.function_prefix }}FindBy{{ index.suffix }}(
  const {{ table.table_name }}* table, {{ index.key_type }} key) {
  int32_t position = {{ index.find_call }}(table->{{ index.array_name }}, table->count, key);

  return position < 0 ? NULL : &table->records[position];
}

bool {{ table.function_prefix }}Contains{{ index.suffix }}(
  const {{ table.table_name }}* table, {{ index.key_type }} key) {
  return {{ index.find_call }}(table->{{ index.array_name }}, table->count, key) >= 0;
}
{{~ end ~}}
