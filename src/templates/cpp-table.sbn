{{~## One table: its record struct and its table class. ##~}}
{{ include 'cpp-file-head.sbn' ~}}
// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
struct {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
  /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
  {{ declaration }}
{{~ end ~}}
{{~ end ~}}
};

{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
class {{ table.table_name }} {
 public:
  const std::vector<{{ table.record_name }}>& records() const { return records_; }

{{~ for index in table.indexes ~}}
  /// The row with this {{ index.field_name }}, or nullptr when the table has none.
  ///
  /// The lookup to reach for when a missing row is an ordinary answer - an optional
  /// reference, a key that came from user input.
  const {{ table.record_name }}* find_by_{{ index.suffix }}({{ index.key_param }} key) const {
    const auto it = {{ index.map_name }}.find(key);
    return it == {{ index.map_name }}.end() ? nullptr : &records_[it->second];
  }

  /// The row with this {{ index.field_name }}, or a thrown exception naming what was missing.
  ///
  /// For a key that has to be there - one from another table, or a constant. The name says
  /// it throws, because a caller reading `get_by_{{ index.suffix }}(key)->name` at a glance
  /// cannot otherwise tell whether the next line is a null check or a catch.
  const {{ table.record_name }}& get_by_{{ index.suffix }}_or_throw({{ index.key_param }} key) const {
    const {{ table.record_name }}* found = find_by_{{ index.suffix }}(key);

    if (found == nullptr) {
      throw sheetman::RecordNotFound(
        std::string("there is no record in table `{{ table.raw_name }}` that corresponds to "
                    "field `{{ index.field_name }}` value ") + {{ index.key_text }});
    }

    return *found;
  }

  /// Whether the table holds a row with this {{ index.field_name }}.
  bool contains_{{ index.suffix }}({{ index.key_param }} key) const {
    return {{ index.map_name }}.find(key) != {{ index.map_name }}.end();
  }

{{~ end ~}}
  /// Loads the table from a .scb file written by SheetMan.
  void read(const std::string& filename) {
    const std::vector<std::uint8_t> buffer = sheetman::read_all_bytes(filename);
    sheetman::LiteBinaryReader reader(buffer);

    // Column by column, matched by tag rather than position: a column this build
    // does not know is skipped by its block length, and one whose type changed
    // incompatibly fails naming the field.
    const sheetman::Header header = sheetman::read_table_header(reader);
    const std::size_t row_count = static_cast<std::size_t>(header.row_count);

    // Read into storage of its own and swapped in at the end: reading a table that is
    // already loaded is a refresh, and one that throws part way through - a truncated
    // file, a column this build cannot read - has to leave the rows already there.
    std::vector<{{ table.record_name }}> records;
    records.resize(row_count);

    for (const sheetman::Column& column : header.columns) {
      const std::size_t block_end = reader.position() + static_cast<std::size_t>(column.byte_length);

      switch (column.tag) {
{{~ for field in table.fields ~}}
        case {{ field.tag }}: {
          {{ field.column_check }}
          for (std::size_t i = 0; i < row_count; ++i) {
            auto& record = records[i];
{{~ if field.kind == "var_array" ~}}
            const std::int32_t element_count = reader.read_counter32();
            record.{{ field.name }}.resize(static_cast<std::size_t>(element_count));
            for (std::int32_t j = 0; j < element_count; ++j) {
              {{ field.read_var_element }};
            }
{{~ else if field.kind == "serial_ref" ~}}
            record.{{ field.name }}.assign({{ field.element_count }}, {{ field.ref_default }});
            record.{{ field.name }}_index.resize({{ field.element_count }});
            for (std::size_t j = 0; j < {{ field.element_count }}; ++j) {
              reader.read(record.{{ field.name }}_index[j]);
            }
{{~ else if field.kind == "serial" ~}}
            record.{{ field.name }}.resize({{ field.element_count }});
            for (std::size_t j = 0; j < {{ field.element_count }}; ++j) {
              {{ field.read_element }};
            }
{{~ else if field.kind == "scalar_ref" ~}}
            reader.read(record.{{ field.name }}_index);
{{~ else ~}}
            {{ field.read_scalar }};
{{~ end ~}}
          }
          break;
        }
{{~ end ~}}
        default:
          // A column added after this code was generated.
          reader.skip(column.byte_length);
          break;
      }

      sheetman::check_block_end(reader, column, block_end);
    }

    publish(std::move(records));
  }

 private:
  friend class Tables;

  /// One whole load, in place of the previous one.
  ///
  /// The indexes are built here rather than by the caller, because they have to arrive
  /// with the rows: a table holding this load's rows and the last one's index would
  /// answer a lookup with a row that is no longer at that position.
  void publish(std::vector<{{ table.record_name }}>&& records) {
{{~ for index in table.indexes ~}}
    std::unordered_map<{{ index.key_type }}, std::size_t> {{ index.suffix }}_map;
    {{ index.suffix }}_map.reserve(records.size());
    for (std::size_t i = 0; i < records.size(); ++i) {
      {{ index.suffix }}_map.emplace(records[i].{{ index.member }}, i);
    }

{{~ end ~}}
    records_ = std::move(records);
{{~ for index in table.indexes ~}}
    {{ index.map_name }} = std::move({{ index.suffix }}_map);
{{~ end ~}}
  }

  std::vector<{{ table.record_name }}> records_;
{{~ for index in table.indexes ~}}
  std::unordered_map<{{ index.key_type }}, std::size_t> {{ index.map_name }};
{{~ end ~}}
};
{{ include 'cpp-file-foot.sbn' ~}}
