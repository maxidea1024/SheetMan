{{~##
   One table: its Record, the read, the indexes and the object-value map.

   One file per table, so deleting a table from the sheets deletes a file rather than
   leaving a hunk of dead code inside a larger one. `table` is the single table this file is
   for; nothing here loops over the model.

   Anything needing the model arrives already rendered from CsView.

   Note for anyone editing: a literal closing brace pair inside a comment ends the comment,
   and a literal opening pair anywhere is read as code.
##~}}
{{ include 'csharp-file-head.sbn' ~}}
{{~ for line in table.comment ~}}
{{~ if for.first ~}}
    /// <summary>
{{~ end ~}}
    /// {{ line }}
{{~ if for.last ~}}
    /// </summary>
{{~ end ~}}
{{~ end ~}}
    [System.Serializable]
    public partial class {{ table.name }}Table
    {
        #region Record
        [System.Serializable]
        public partial class Record
        {
            #region Fields
{{~ for field in table.fields ~}}
{{~ if !for.first }}
{{ end ~}}
{{~ for line in field.comment ~}}
{{~ if for.first ~}}
            /// <summary>
{{~ end ~}}
            /// {{ line }}
{{~ if for.last ~}}
            /// </summary>
{{~ end ~}}
{{~ end ~}}
{{~ if field.kind == 'array_ref' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
            public const int {{ field.prop_name }}_N = {{ field.element_count }};
            internal {{ field.field_type }}[] {{ field.field_name }} = new {{ field.field_type }}[{{ field.field_name }}_N];
            public void SetReference_{{ field.prop_name }}_INTERNAL(int index, {{ field.reference_setter_type }} value) => {{ field.field_name }}[index] = value;
            public int[] {{ field.field_name }}_{{ field.ref_table }}_index = new int[{{ field.prop_name }}_N];
            public bool[] {{ field.field_name }}_F = new bool[{{ field.field_name }}_N];
{{~ else if field.kind == 'var_array' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
            internal {{ field.field_type }}[] {{ field.field_name }} = System.Array.Empty<{{ field.field_type }}>();
{{~ else if field.kind == 'array' ~}}
            public {{ field.field_type }}[] {{ field.prop_name }} => {{ field.field_name }};
            public const int {{ field.prop_name }}_N = {{ field.element_count }};
            internal {{ field.field_type }}[] {{ field.field_name }} = System.Array.Empty<{{ field.field_type }}>();
{{~ else if field.kind == 'scalar_ref' ~}}
            public {{ field.field_type }} {{ field.prop_name }} => {{ field.field_name }};
            internal {{ field.field_type }} {{ field.field_name }};
            public void SetReference_{{ field.prop_name }}_INTERNAL({{ field.reference_setter_type }} value) => {{ field.field_name }} = value;
            public int {{ field.field_name }}_{{ field.ref_table }}_index;
            public bool {{ field.field_name }}_F = false;
{{~ else ~}}
            public {{ field.field_type }} {{ field.prop_name }} => {{ field.field_name }};
            internal {{ field.field_type }} {{ field.field_name }}{{ field.initializer }};
{{~ end ~}}
{{~ end ~}}
            #endregion

            #region ToString
            public override string ToString()
            {
                var sb = new StringBuilder("{");
{{~ for field in table.fields ~}}
{{~ if for.first ~}}
                sb.Append("\"{{ field.prop_name }}\":"); ToStringHelper.ToString({{ field.prop_name }}, sb);
{{~ else ~}}
                sb.Append(",\"{{ field.prop_name }}\":"); ToStringHelper.ToString({{ field.prop_name }}, sb);
{{~ end ~}}
{{~ end ~}}
                sb.Append("}");
                return sb.ToString();
            }
            #endregion
        }
        #endregion

        /// <summary>
        /// Field names.
        /// </summary>
        public static readonly string[] FieldNames = { {{ table.field_name_literals }} };

        /// <summary>
        /// Build object value map.
        /// </summary>
        public List<object[]> BuildObjectValueMap()
        {
            var result = new List<object[]>();
            foreach (var r in _records)
                result.Add(new object[] { {{ table.field_value_expressions }} });

            return result;
        }

        /// <summary>
        /// All records.
        /// </summary>
        public List<Record> Records => _records;
        private readonly List<Record> _records = new List<Record>();
{{~ for field in table.indexed_fields }}
        #region Indexing by '{{ field.prop_name }}'
        public Dictionary<{{ field.field_type }}, Record> RecordsBy{{ field.prop_name }} => _recordsBy{{ field.prop_name }};
        private readonly Dictionary<{{ field.field_type }}, Record> _recordsBy{{ field.prop_name }} = new Dictionary<{{ field.field_type }}, Record>();

        /// <summary>
        /// Gets the value associated with the specified key. throw SheetManException if not found.
        /// </summary>
        public Record GetBy{{ field.prop_name }}({{ field.field_type }} key)
        {
            if (!TryGetBy{{ field.prop_name }}(key, out Record record))
                throw new SheetManException($"There is no record in table `{{ table.raw_name }}` that corresponds to field `{{ field.prop_name }}` value {key}");

            return record;
        }

        /// <summary>
        /// Gets the value associated with the specified key.
        /// </summary>
        public bool TryGetBy{{ field.prop_name }}({{ field.field_type }} key, out Record result) => _recordsBy{{ field.prop_name }}.TryGetValue(key, out result);

        /// <summary>
        /// Determines whether the table contains the specified key.
        /// </summary>
        public bool Contains{{ field.prop_name }}({{ field.field_type }} key) => _recordsBy{{ field.prop_name }}.ContainsKey(key);
        #endregion // Indexing by `{{ field.prop_name }}`
{{~ end ~}}

        /// <summary>
        /// Read a table from specified file.
        /// </summary>
        public async Task ReadAsync(string filename)
        {
            var bytes = await Tables.ReadAllBytesAsync(filename);
            var reader = new LiteBinaryReader(bytes);
            await ReadAsync(reader);
        }

        /// <summary>
        /// Read a table from specified reader.
        /// </summary>
        /// <remarks>
        /// Column by column, matched by tag rather than position. A column this build does
        /// not know is skipped by its block length; one it knows but cannot read - the type
        /// changed incompatibly - fails naming the field. Order, names and columns added or
        /// removed on either side are therefore all survivable.
        /// </remarks>
        public Task ReadAsync(LiteBinaryReader reader)
        {
            var columns = LiteBinaryTable.ReadHeader(reader, out int count);
{{~ if table.needs_enum_temp ~}}
            int tempEnumInt = 0;
{{~ end ~}}

            _records.Clear();
            for (int i = 0; i < count; i++)
                _records.Add(new Record());

            foreach (var column in columns)
            {
                int blockEnd = reader.Position + column.ByteLength;

                switch (column.Tag)
                {
{{~ for field in table.fields ~}}
                    case {{ field.tag }}:
                        {{ field.column_check }}
{{~ if field.read_kind == 'var_array' ~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = _records[i];
                            reader.TryReadCounter32(out int elementCount);
                            record.{{ field.field_name }} = new {{ field.field_type }}[elementCount];
                            for (int j = 0; j < elementCount; ++j)
                            {
{{~ for line in field.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else if field.read_kind == 'serial' ~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = _records[i];
                            record.{{ field.field_name }} = new {{ field.field_type }}[Record.{{ field.prop_name }}_N];
                            for (int j = 0; j < Record.{{ field.prop_name }}_N; ++j)
                            {
{{~ for line in field.element_read ~}}
                                {{ line }}
{{~ end ~}}
                            }
                        }
{{~ else ~}}
                        for (int i = 0; i < count; i++)
                        {
                            var record = _records[i];
{{~ for line in field.element_read ~}}
                            {{ line }}
{{~ end ~}}
                        }
{{~ end ~}}
                        break;

{{~ end ~}}
                    default:
                        // A column added after this code was generated. Its block length
                        // says how far to move on.
                        reader.Skip(column.ByteLength);
                        break;
                }

                LiteBinaryTable.CheckBlockEnd(reader, column, blockEnd);
            }
{{~ if table.indexed_fields | array.size > 0 }}
            // Index mapping
{{~ for field in table.indexed_fields ~}}
            foreach (var record in _records)
                _recordsBy{{ field.prop_name }}.Add(record.{{ field.prop_name }}, record);
{{~ end ~}}
{{~ end }}
            return Task.CompletedTask;
        }

        public override string ToString()
        {
            var sb = new StringBuilder();
            ToStringHelper.ToString(_records, sb);
            return sb.ToString();
        }
    }
{{ include 'csharp-file-foot.sbn' ~}}
