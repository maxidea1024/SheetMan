{{~## One table: its record class and its table class. ##~}}
{{ include 'dart-part-head.sbn' ~}}
// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
class {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
  /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
  {{ declaration }}
{{~ end ~}}
{{~ end ~}}

}

/// Every row of {{ table.raw_name }}.
class {{ table.table_name }} {
  /// Every row, in the order the sheet declared them.
  ///
  /// The list a read published, not one a read fills. A refresh replaces the reference
  /// rather than the contents, so whoever holds this holds one whole load.
  List<{{ table.record_name }}> get records => _records;
  List<{{ table.record_name }}> _records = [];

{{~ for index in table.indexes ~}}
  Map<{{ index.key_type }}, {{ table.record_name }}> {{ index.map_name }} = {};
{{~ end ~}}
{{~ for index in table.indexes }}
  /// The row with this {{ index.field_name }}, or null when the table has none.
  ///
  /// The lookup to reach for when a missing row is an ordinary answer - an optional
  /// reference, a key that came from user input.
  {{ table.record_name }}? findBy{{ index.suffix }}({{ index.key_type }} key) => {{ index.map_name }}[key];

  /// The row with this {{ index.field_name }}, or a thrown exception naming what was missing.
  ///
  /// For a key that has to be there - one from another table, or a constant. The name says
  /// it throws, because a caller reading getBy{{ index.suffix }}(key).name at a glance
  /// cannot otherwise tell whether the next line is a null check or a catch.
  {{ table.record_name }} getBy{{ index.suffix }}OrThrow({{ index.key_type }} key) {
    final record = {{ index.map_name }}[key];

    if (record == null) {
      throw RecordNotFoundException(
          'there is no record in table `{{ table.raw_name }}` that corresponds to '
          'field `{{ index.field_name }}` value $key');
    }

    return record;
  }

  /// Whether the table holds a row with this {{ index.field_name }}.
  bool contains{{ index.suffix }}({{ index.key_type }} key) => {{ index.map_name }}.containsKey(key);
{{~ end ~}}

  /// Loads the table from a .scb file written by SheetMan.
  /// Column by column, matched by tag rather than position: a column this build does
  /// not know is skipped by its block length, and one whose type changed incompatibly
  /// fails naming the field.
  void read(String filename) {
    final reader = ScbReader(readAllBytes(filename));
    final header = readTableHeader(reader);
    final count = header.rowCount;
{{~ if table.needs_cursor ~}}
    late ScbColumnCursor cursor;
{{~ end ~}}

    // Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
    final loaded = <{{ table.record_name }}>[];
{{~ for index in table.indexes ~}}
    final loadedBy{{ index.suffix }} = <{{ index.key_type }}, {{ table.record_name }}>{};
{{~ end ~}}

    for (var i = 0; i < count; i++) {
      loaded.add({{ table.record_name }}());
    }

    for (final column in header.columns) {
      final blockEnd = reader.position + column.byteLength;

      switch (column.tag) {
{{~ for field in table.fields ~}}
        case {{ field.tag }}:
          {{ field.column_check }}
{{~ if field.cursor_open != '' ~}}
          {{ field.cursor_open }}
{{~ end ~}}
          for (final record in loaded) {
{{~ if field.kind == 'var_array' ~}}
            final elementCount = reader.readCounter32();
            record.{{ field.name }} = List.generate(elementCount, (_) => {{ field.read_element }});
{{~ else if field.kind == 'serial_ref' ~}}
            record.{{ field.name }}Index = List.generate({{ field.element_count }}, (_) => reader.readInt32());
{{~ else if field.kind == 'serial' ~}}
            record.{{ field.name }} = List.generate({{ field.element_count }}, (_) => {{ field.read_element }});
{{~ else if field.kind == 'scalar_ref' ~}}
            record.{{ field.name }}Index = {{ field.read_scalar }};
{{~ else ~}}
            record.{{ field.name }} = {{ field.read_scalar }};
{{~ end ~}}
          }
          break;
{{~ end ~}}
        default:
          // A column added after this code was generated.
          reader.skip(column.byteLength);
          break;
      }

      checkBlockEnd(reader, column, blockEnd);
    }

    for (final record in loaded) {
{{~ for index in table.indexes ~}}
      loadedBy{{ index.suffix }}[record.{{ index.member }}] = record;
{{~ end ~}}
    }

    // Published, now that every column read.
    _records = loaded;
{{~ for index in table.indexes ~}}
    {{ index.map_name }} = loadedBy{{ index.suffix }};
{{~ end ~}}
  }
}
