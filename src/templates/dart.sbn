{{~ end ~}}
  static final {{ constant.type }} {{ constant.name }} = {{ constant.value }};
{{~ end ~}}
}
{{~ end ~}}
{{~ for table in tables }}

// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
class {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
  /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
  {{ declaration }}
{{~ end ~}}
{{~ end ~}}

  /// Reads one record, in the exact field order the exporter wrote.
  void read(LiteBinaryReader reader) {
{{~ if table.fields | array.size == 0 ~}}
    // No fields to read.
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ if field.kind == 'var_array' ~}}
    {
      final count = reader.readCounter32();
      {{ field.name }} = List.generate(count, (_) => {{ field.read_element }});
    }
{{~ else if field.kind == 'serial_ref' ~}}
    {{ field.name }}Index = List.generate({{ field.element_count }}, (_) => reader.readInt32());
    {{ field.name }} = List.filled({{ field.element_count }}, null);
{{~ else if field.kind == 'serial' ~}}
    {{ field.name }} = List.generate({{ field.element_count }}, (_) => {{ field.read_element }});
{{~ else if field.kind == 'scalar_ref' ~}}
    {{ field.name }}Index = reader.readInt32();
{{~ else ~}}
    {{ field.name }} = {{ field.read_scalar }};
{{~ end ~}}
{{~ end ~}}
  }
}

/// Every row of {{ table.raw_name }}.
class {{ table.table_name }} {
  /// Every row, in the order the sheet declared them.
  final List<{{ table.record_name }}> records = [];

  final Map<int, {{ table.record_name }}> _byIndex = {};

  /// The row with the given primary index, or null when there is none.
  {{ table.record_name }}? find(int index) => _byIndex[index];

  /// Loads the table from a .table file written by SheetMan.
  void read(String filename) {
    final reader = LiteBinaryReader(readAllBytes(filename));
    final count = readTableHeader(reader);

    records.clear();
    _byIndex.clear();

    for (var i = 0; i < count; i++) {
      final record = {{ table.record_name }}();
      record.read(reader);
      records.add(record);
    }

    for (final record in records) {
      _byIndex[record.{{ table.index_field }}] = record;
    }
  }
}
{{~ end }}

/// Every table, loaded together so cross-table references can be resolved.
class Tables {
{{~ for slot in accessor.tables ~}}
  final {{ slot.table_name }} {{ slot.name }} = {{ slot.table_name }}();
{{~ end ~}}

  /// Reads every table from basePath, then links the references between them.
  void readAll(String basePath) {
{{~ if accessor.tables | array.size == 0 ~}}
    // No tables to read.
{{~ else ~}}
{{~ for slot in accessor.tables ~}}
    {{ slot.name }}.read('$basePath${Platform.pathSeparator}{{ slot.data_file_name }}{{ accessor.file_extension }}');
{{~ end ~}}

    _solveCrossReferences();
{{~ end ~}}
  }

  /// Turns the stored indices into usable values, once every table is in memory.
  void _solveCrossReferences() {
{{~ if accessor.cross_references | array.size == 0 ~}}
    // No table references another.
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
    for (final record in {{ reference.table }}.records) {
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
      for (var i = 0; i < record.{{ field.name }}Index.length; i++) {
        final target = {{ field.ref_table }}.find(record.{{ field.name }}Index[i]);
        if (target != null) record.{{ field.name }}[i] = {{ field.value }};
      }
{{~ else ~}}
      {
        final target = {{ field.ref_table }}.find(record.{{ field.name }}Index);
        if (target != null) record.{{ field.name }} = {{ field.value }};
      }
{{~ end ~}}
{{~ end ~}}
    }
{{~ end ~}}
{{~ end ~}}
  }
}
