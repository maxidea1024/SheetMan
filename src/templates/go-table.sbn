{{~## One table: its record struct and its table type. ##~}}
{{ include 'go-file-head.sbn' ~}}
// {{ table.record_name }} was generated from {{ table.location }}.
{{~ for line in table.comment ~}}
// {{ line }}
{{~ end ~}}
type {{ table.record_name }} struct {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
	// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
	{{ declaration }}
{{~ end ~}}
{{~ end ~}}
}

// read fills the record from the reader, in the exact field order the exporter wrote.

// {{ table.table_name }} holds every row of {{ table.raw_name }}.
type {{ table.table_name }} struct {
	records []{{ table.record_name }}
	byIndex map[int32]int
}

// Records returns every row, in the order the sheet declared them.
func (t *{{ table.table_name }}) Records() []{{ table.record_name }} { return t.records }

// Find returns the row with the given primary index, or nil when there is none.
func (t *{{ table.table_name }}) Find(index int32) *{{ table.record_name }} {
	position, found := t.byIndex[index]
	if !found {
		return nil
	}

	return &t.records[position]
}

// Read loads the table from a .table file written by SheetMan.
func (t *{{ table.table_name }}) Read(filename string) error {
	data, err := sheetman.ReadAllBytes(filename)
	if err != nil {
		return err
	}

	reader := sheetman.NewReader(data)
	count, columns := sheetman.ReadTableHeader(reader)

	// Column by column, matched by tag rather than position: a column this build does
	// not know is skipped by its block length, and one whose type changed incompatibly
	// fails naming the field.
	t.records = make([]{{ table.record_name }}, count)

	for _, column := range columns {
		blockEnd := reader.Position() + int(column.ByteLength)

		switch column.Tag {
{{~ for field in table.fields ~}}
		case {{ field.tag }}:
			if {{ field.column_check }} {
				for i := int32(0); i < count; i++ {
					r := &t.records[i]
{{~ if field.kind == 'var_array' ~}}
					elementCount := int(reader.ReadCounter32())
					r.{{ field.name }} = make({{ field.array_type }}, elementCount)
					for j := 0; j < elementCount; j++ {
						r.{{ field.name }}[j] = {{ field.read_element }}
					}
{{~ else if field.kind == 'serial_ref' ~}}
					r.{{ field.name }} = make({{ field.array_type }}, {{ field.element_count }})
					r.{{ field.name }}Index = make([]int32, {{ field.element_count }})
					for j := 0; j < {{ field.element_count }}; j++ {
						r.{{ field.name }}Index[j] = reader.ReadInt32()
					}
{{~ else if field.kind == 'serial' ~}}
					r.{{ field.name }} = make({{ field.array_type }}, {{ field.element_count }})
					for j := 0; j < {{ field.element_count }}; j++ {
						r.{{ field.name }}[j] = {{ field.read_element }}
					}
{{~ else if field.kind == 'scalar_ref' ~}}
					r.{{ field.name }}Index = reader.ReadInt32()
{{~ else ~}}
					r.{{ field.name }} = {{ field.read_scalar }}
{{~ end ~}}
				}
			}
{{~ end ~}}
		default:
			// A column added after this code was generated.
			reader.Skip(column.ByteLength)
		}

		sheetman.CheckBlockEnd(reader, column, blockEnd)
	}

	if err := reader.Err(); err != nil {
		return fmt.Errorf("{{ table.raw_name }}: %w", err)
	}

	t.byIndex = make(map[int32]int, len(t.records))
	for i := range t.records {
		t.byIndex[t.records[i].{{ table.index_field }}] = i
	}

	return nil
}
