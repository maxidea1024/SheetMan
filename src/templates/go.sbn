// regenerated.
// ------------------------------------------------------------------------------

package {{ package_name }}

import (
{{~ for line in imports ~}}
	{{ line }}
{{~ end ~}}
)
{{~ for enumm in enums }}

// {{ enumm.name }} was generated from {{ enumm.location }}.
{{~ for line in enumm.comment ~}}
// {{ line }}
{{~ end ~}}
type {{ enumm.name }} int32

const (
{{~ for label in enumm.labels ~}}
{{~ for line in label.comment ~}}
	// {{ line }}
{{~ end ~}}
	{{ enumm.name }}{{ label.name }} {{ enumm.name }} = {{ label.value }}
{{~ end ~}}
)

// String names the label, or renders the number when the value has none.
func (v {{ enumm.name }}) String() string {
	switch v {
{{~ for label in enumm.labels ~}}
	case {{ enumm.name }}{{ label.name }}:
		return "{{ label.name }}"
{{~ end ~}}
	}

	return strconv.FormatInt(int64(v), 10)
}
{{~ end ~}}
{{~ for set in constant_sets }}

// {{ set.name }} was generated from {{ set.location }}.
{{~ for line in set.comment ~}}
// {{ line }}
{{~ end ~}}
var {{ set.name }} = struct {
{{~ for constant in set.constants ~}}
	{{ constant.name }} {{ constant.type }}
{{~ end ~}}
}{
{{~ for constant in set.constants ~}}
{{~ for line in constant.comment ~}}
	// {{ line }}
{{~ end ~}}
	{{ constant.name }}: {{ constant.value }},
{{~ end ~}}
}
{{~ end ~}}
{{~ for table in tables }}

// {{ table.record_name }} was generated from {{ table.location }}.
{{~ for line in table.comment ~}}
// {{ line }}
{{~ end ~}}
type {{ table.record_name }} struct {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
	// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
	{{ declaration }}
{{~ end ~}}
{{~ end ~}}
}

// read fills the record from the reader, in the exact field order the exporter wrote.
func (r *{{ table.record_name }}) read(reader *sheetman.Reader) {
{{~ if table.fields | array.size == 0 ~}}
	_ = reader
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ if field.kind == 'var_array' ~}}
	{
		count := int(reader.ReadCounter32())
		r.{{ field.name }} = make({{ field.array_type }}, count)
		for i := 0; i < count; i++ {
			r.{{ field.name }}[i] = {{ field.read_element }}
		}
	}
{{~ else if field.kind == 'serial_ref' ~}}
	r.{{ field.name }} = make({{ field.array_type }}, {{ field.element_count }})
	r.{{ field.name }}Index = make([]int32, {{ field.element_count }})
	for i := 0; i < {{ field.element_count }}; i++ {
		r.{{ field.name }}Index[i] = reader.ReadInt32()
	}
{{~ else if field.kind == 'serial' ~}}
	r.{{ field.name }} = make({{ field.array_type }}, {{ field.element_count }})
	for i := 0; i < {{ field.element_count }}; i++ {
		r.{{ field.name }}[i] = {{ field.read_element }}
	}
{{~ else if field.kind == 'scalar_ref' ~}}
	r.{{ field.name }}Index = reader.ReadInt32()
{{~ else ~}}
	r.{{ field.name }} = {{ field.read_scalar }}
{{~ end ~}}
{{~ end ~}}
}

// {{ table.table_name }} holds every row of {{ table.raw_name }}.
type {{ table.table_name }} struct {
	records []{{ table.record_name }}
	byIndex map[int32]int
}

// Records returns every row, in the order the sheet declared them.
func (t *{{ table.table_name }}) Records() []{{ table.record_name }} { return t.records }

// Find returns the row with the given primary index, or nil when there is none.
func (t *{{ table.table_name }}) Find(index int32) *{{ table.record_name }} {
	position, found := t.byIndex[index]
	if !found {
		return nil
	}

	return &t.records[position]
}

// Read loads the table from a .table file written by SheetMan.
func (t *{{ table.table_name }}) Read(filename string) error {
	data, err := sheetman.ReadAllBytes(filename)
	if err != nil {
		return err
	}

	reader := sheetman.NewReader(data)
	count := sheetman.ReadTableHeader(reader)

	t.records = make([]{{ table.record_name }}, count)
	for i := int32(0); i < count; i++ {
		t.records[i].read(reader)
	}

	if err := reader.Err(); err != nil {
		return fmt.Errorf("{{ table.raw_name }}: %w", err)
	}

	t.byIndex = make(map[int32]int, len(t.records))
	for i := range t.records {
		t.byIndex[t.records[i].{{ table.index_field }}] = i
	}

	return nil
}
{{~ end }}

// Tables holds every table, loaded together so cross-table references can be resolved.
type Tables struct {
{{~ for slot in accessor.tables ~}}
	{{ slot.name }} {{ slot.table_name }}
{{~ end ~}}
}

// ReadAll reads every table from basePath, then links the references between them.
func (t *Tables) ReadAll(basePath string) error {
{{~ if accessor.tables | array.size == 0 ~}}
	_ = basePath
{{~ else ~}}
{{~ for slot in accessor.tables ~}}
	if err := t.{{ slot.name }}.Read(filepath.Join(basePath, "{{ slot.data_file_name }}{{ accessor.file_extension }}")); err != nil {
		return err
	}
{{~ end ~}}

	t.solveCrossReferences()
{{~ end ~}}

	return nil
}

// solveCrossReferences turns the stored indices into usable values, once every table is
// in memory.
func (t *Tables) solveCrossReferences() {
{{~ if accessor.cross_references | array.size == 0 ~}}
	// No table references another.
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
	for i := range t.{{ reference.table }}.records {
		record := &t.{{ reference.table }}.records[i]
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
		for k := range record.{{ field.name }}Index {
			if target := t.{{ field.ref_table }}.Find(record.{{ field.name }}Index[k]); target != nil {
				record.{{ field.name }}[k] = {{ field.value }}
			}
		}
{{~ else ~}}
		if target := t.{{ field.ref_table }}.Find(record.{{ field.name }}Index); target != nil {
			record.{{ field.name }} = {{ field.value }}
		}
{{~ end ~}}
{{~ end ~}}
	}
{{~ end ~}}
{{~ end ~}}
}
