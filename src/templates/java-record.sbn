{{~## One table's record. Its own file, because Java demands a public type be alone in one. ##~}}
{{ include 'java-file-head.sbn' ~}}
// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/** {{ line }} */
{{~ end ~}}
public final class {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    public {{ declaration }}
{{~ end ~}}
{{~ end ~}}

    /** Reads one record, in the exact field order the exporter wrote. */
    void read(LiteBinaryReader reader) {
{{~ if table.fields | array.size == 0 ~}}
        // No fields to read.
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ if field.kind == 'var_array' ~}}
        {
            int count = reader.readCounter32();
                {{ field.name }} = new {{ field.element_type }}[count];
            for (int i = 0; i < count; i++) {
                    {{ field.name }}[i] = {{ field.read_element }};
            }
        }
{{~ else if field.kind == 'serial_ref' ~}}
            {{ field.name }} = new {{ field.element_type }}[{{ field.element_count }}];
            {{ field.name }}Index = new int[{{ field.element_count }}];
        for (int i = 0; i < {{ field.element_count }}; i++) {
                {{ field.name }}Index[i] = reader.readInt32();
        }
{{~ else if field.kind == 'serial' ~}}
            {{ field.name }} = new {{ field.element_type }}[{{ field.element_count }}];
        for (int i = 0; i < {{ field.element_count }}; i++) {
                {{ field.name }}[i] = {{ field.read_element }};
        }
{{~ else if field.kind == 'scalar_ref' ~}}
            {{ field.name }}Index = reader.readInt32();
{{~ else ~}}
            {{ field.name }} = {{ field.read_scalar }};
{{~ end ~}}
{{~ end ~}}
    }
}
