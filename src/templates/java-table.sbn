{{~## One table's table type. ##~}}
{{ include 'java-file-head.sbn' ~}}
/** Every row of {{ table.raw_name }}. */
public final class {{ table.table_name }} {
    private List<{{ table.record_name }}> records = new ArrayList<>();
    private Map<Integer, {{ table.record_name }}> byIndex = new HashMap<>();

    /**
     * Every row, in the order the sheet declared them.
     *
     * The list a read published, not one a read fills. A refresh replaces the reference
     * rather than the contents, so whoever holds this holds one whole load.
     */
    public List<{{ table.record_name }}> records() {
        return records;
    }

    /** The row with the given primary index, or null when there is none. */
    public {{ table.record_name }} find(int index) {
        return byIndex.get(index);
    }

    /** Loads the table from a .table file written by SheetMan. */
    /**
     * Column by column, matched by tag rather than position: a column this build does not
     * know is skipped by its block length, and one whose type changed incompatibly fails
     * naming the field.
     */
    public void read(Path filename) {
        LiteBinaryReader reader = new LiteBinaryReader(LiteBinaryReader.readAllBytes(filename));
        LiteBinaryReader.Header header = LiteBinaryReader.readTableHeader(reader);
        int count = header.rowCount;

        // Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
        List<{{ table.record_name }}> loaded = new ArrayList<>(count);
        Map<Integer, {{ table.record_name }}> loadedByIndex = new HashMap<>(count * 2);

        for (int i = 0; i < count; i++) {
            loaded.add(new {{ table.record_name }}());
        }

        for (LiteBinaryReader.Column column : header.columns) {
            int blockEnd = reader.position() + column.byteLength;

            switch (column.tag) {
{{~ for field in table.fields ~}}
                case {{ field.tag }}: {
                    {{ field.column_check }}
                    for ({{ table.record_name }} record : loaded) {
{{~ if field.kind == 'var_array' ~}}
                        int elementCount = reader.readCounter32();
                        record.{{ field.name }} = new {{ field.element_type }}[elementCount];
                        for (int j = 0; j < elementCount; j++) {
                            record.{{ field.name }}[j] = {{ field.read_element }};
                        }
{{~ else if field.kind == 'serial_ref' ~}}
                        record.{{ field.name }} = new {{ field.element_type }}[{{ field.element_count }}];
                        record.{{ field.name }}Index = new int[{{ field.element_count }}];
                        for (int j = 0; j < {{ field.element_count }}; j++) {
                            record.{{ field.name }}Index[j] = reader.readInt32();
                        }
{{~ else if field.kind == 'serial' ~}}
                        record.{{ field.name }} = new {{ field.element_type }}[{{ field.element_count }}];
                        for (int j = 0; j < {{ field.element_count }}; j++) {
                            record.{{ field.name }}[j] = {{ field.read_element }};
                        }
{{~ else if field.kind == 'scalar_ref' ~}}
                        record.{{ field.name }}Index = reader.readInt32();
{{~ else ~}}
                        record.{{ field.name }} = {{ field.read_scalar }};
{{~ end ~}}
                    }
                    break;
                }
{{~ end ~}}
                default:
                    // A column added after this code was generated.
                    reader.skip(column.byteLength);
                    break;
            }

            LiteBinaryReader.checkBlockEnd(reader, column, blockEnd);
        }

        for ({{ table.record_name }} record : loaded) {
            loadedByIndex.put(record.{{ table.index_field }}, record);
        }

        // Published, now that every column read.
        records = loaded;
        byIndex = loadedByIndex;
    }
}
