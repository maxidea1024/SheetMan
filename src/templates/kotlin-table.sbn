{{~##
   One table: its record class and its table class. `table` is the single table this file
   is for, so nothing here loops over the model.
##~}}
{{ include 'kotlin-file-head.sbn' ~}}

// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/** {{ line }} */
{{~ end ~}}
class {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    {{ declaration }}
{{~ end ~}}
{{~ end ~}}

}

/** Every row of {{ table.raw_name }}. */
class {{ table.table_name }} {

    /**
     * Every row, in the order the sheet declared them.
     *
     * The list a read published, not one a read fills. A refresh replaces the reference
     * rather than the contents, so whoever holds this holds one whole load.
     */
    var records: MutableList<{{ table.record_name }}> = ArrayList()
        private set

    private var byIndex: HashMap<Int, {{ table.record_name }}> = HashMap()

    /** The row with the given primary index, or null when there is none. */
    fun find(index: Int): {{ table.record_name }}? = byIndex[index]

    /** Loads the table from a .table file written by SheetMan. */
    /**
     * Column by column, matched by tag rather than position: a column this build does not
     * know is skipped by its block length, and one whose type changed incompatibly fails
     * naming the field.
     */
    fun read(filename: String) {
        val reader = LiteBinaryReader(readAllBytes(filename))
        val header = readTableHeader(reader)
        val count = header.rowCount

        // Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
        val loaded = ArrayList<{{ table.record_name }}>(count)
        val loadedByIndex = HashMap<Int, {{ table.record_name }}>(count * 2)

        repeat(count) { loaded.add({{ table.record_name }}()) }

        for (column in header.columns) {
            val blockEnd = reader.position + column.byteLength

            when (column.tag) {
{{~ for field in table.fields ~}}
                {{ field.tag }} -> {
                    {{ field.column_check }}
                    for (record in loaded) {
{{~ if field.kind == 'var_array' ~}}
                        val elementCount = reader.readCounter32()
                        record.{{ field.name }} = ArrayList(elementCount.coerceAtLeast(0))
                        repeat(elementCount) { record.{{ field.name }}.add({{ field.read_element }}) }
{{~ else if field.kind == 'serial_ref' ~}}
                        record.{{ field.name }}Index = ArrayList({{ field.element_count }})
                        repeat({{ field.element_count }}) { record.{{ field.name }}Index.add(reader.readInt32()) }
{{~ else if field.kind == 'serial' ~}}
                        record.{{ field.name }} = ArrayList({{ field.element_count }})
                        repeat({{ field.element_count }}) { record.{{ field.name }}.add({{ field.read_element }}) }
{{~ else if field.kind == 'scalar_ref' ~}}
                        record.{{ field.name }}Index = reader.readInt32()
{{~ else ~}}
                        record.{{ field.name }} = {{ field.read_scalar }}
{{~ end ~}}
                    }
                }
{{~ end ~}}
                else ->
                    // A column added after this code was generated.
                    reader.skip(column.byteLength)
            }

            checkBlockEnd(reader, column, blockEnd)
        }

        for (record in loaded) {
            loadedByIndex[record.{{ table.index_field }}] = record
        }

        // Published, now that every column read.
        records = loaded
        byIndex = loadedByIndex
    }
}
