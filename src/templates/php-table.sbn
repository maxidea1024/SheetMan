{{~##
   One table: its record class and its table class. `table` is the single table this file is
   for, so nothing here loops over the model.
##~}}
{{ include 'php-file-head.sbn' ~}}
/**
 * Generated from {{ table.location }}
{{~ for line in table.comment ~}}
 *
 * {{ line }}
{{~ end ~}}
 */
final class {{ table.record_name }}
{
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ for line in field.declarations ~}}
    {{ line }}
{{~ end ~}}
{{~ end ~}}
}

/** Every row of {{ table.raw_name }}. */
final class {{ table.table_name }}
{
    /** @var list<{{ table.record_name }}> */
    public array $records = [];

{{~ for index in table.indexes ~}}
    /** @var array<{{ index.key_doc_type }}, {{ table.record_name }}> */
    private array ${{ index.map_name }} = [];

{{~ end ~}}
{{~ for index in table.indexes ~}}
    /**
     * The row with this {{ index.field_name }}, or null when the table has none.
     *
     * The lookup to reach for when a missing row is an ordinary answer - an optional
     * reference, a key that came from user input.
     */
    public function findBy{{ index.suffix }}({{ index.key_type }} $key): ?{{ table.record_name }}
    {
        return $this->{{ index.map_name }}[$key] ?? null;
    }

    /**
     * The row with this {{ index.field_name }}, or a thrown exception naming what was missing.
     *
     * For a key that has to be there - one from another table, or a constant. The name says
     * it throws, because a caller reading getBy{{ index.suffix }}($key)->name at a glance
     * cannot otherwise tell whether the next line is a null check or a catch.
     */
    public function getBy{{ index.suffix }}OrThrow({{ index.key_type }} $key): {{ table.record_name }}
    {
        $record = $this->{{ index.map_name }}[$key] ?? null;

        if ($record === null) {
            throw new RecordNotFoundException(
                "There is no record in table `{{ table.raw_name }}` that corresponds to " .
                "field `{{ index.field_name }}` value {$key}.");
        }

        return $record;
    }

    /** Whether the table holds a row with this {{ index.field_name }}. */
    public function contains{{ index.suffix }}({{ index.key_type }} $key): bool
    {
        return isset($this->{{ index.map_name }}[$key]);
    }

{{~ end ~}}
    /** Loads the table from a .scb file written by SheetMan. */
    /**
     * Column by column, matched by tag rather than position: a column this build does not
     * know is skipped by its block length, and one whose type changed incompatibly fails
     * naming the field.
     */
    public function read(string $filename): void
    {
        $reader = ScbReader::fromFile($filename);
        [$count, $columns] = $reader->readTableHeader();

        // Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
        $records = [];
{{~ for index in table.indexes ~}}
        {{ index.local_name }} = [];
{{~ end ~}}

        for ($i = 0; $i < $count; $i++) {
            $records[] = new {{ table.record_name }}();
        }

        foreach ($columns as $column) {
            $blockEnd = $reader->position() + $column['byteLength'];

            switch ($column['tag']) {
{{~ for field in table.fields ~}}
                case {{ field.tag }}:
                    {{ field.column_check }}
{{~ if field.cursor_open != '' ~}}
                    {{ field.cursor_open }}
{{~ end ~}}
                    foreach ($records as $record) {
{{~ if field.kind == 'var_array' ~}}
                        $elementCount = $reader->readCounter32();
                        $record->{{ field.name }} = [];
                        for ($j = 0; $j < $elementCount; $j++) {
                            $record->{{ field.name }}[] = {{ field.read_element }};
                        }
{{~ else if field.kind == 'serial_ref' ~}}
                        $record->{{ field.name }}Index = [];
                        for ($j = 0; $j < {{ field.element_count }}; $j++) {
                            $record->{{ field.name }}Index[] = $reader->readInt32();
                        }
                        $record->{{ field.name }} = \array_fill(0, {{ field.element_count }}, null);
{{~ else if field.kind == 'serial' ~}}
                        $record->{{ field.name }} = [];
                        for ($j = 0; $j < {{ field.element_count }}; $j++) {
                            $record->{{ field.name }}[] = {{ field.read_element }};
                        }
{{~ else if field.kind == 'scalar_ref' ~}}
                        $record->{{ field.name }}Index = $cursor->nextI32();
{{~ else ~}}
                        $record->{{ field.name }} = {{ field.read_scalar }};
{{~ end ~}}
                    }
                    break;

{{~ end ~}}
                default:
                    // A column added after this code was generated.
                    $reader->skip($column['byteLength']);
                    break;
            }

            $reader->checkBlockEnd($column, $blockEnd);
        }

        foreach ($records as $record) {
{{~ for index in table.indexes ~}}
            {{ index.local_name }}[$record->{{ index.member }}] = $record;
{{~ end ~}}
        }

        // Published, now that every column read.
        $this->records = $records;
{{~ for index in table.indexes ~}}
        $this->{{ index.map_name }} = {{ index.local_name }};
{{~ end ~}}
    }
}
