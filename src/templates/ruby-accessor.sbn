{{~## The accessor, holding no table's own code. ##~}}
{{ include 'ruby-file-head.sbn' ~}}
  # Every table, loaded together so cross-table references can be resolved.
  class Tables
    attr_reader {{ accessor.reader_names }}

    def initialize
{{~ if accessor.tables | array.size == 0 ~}}
      nil
{{~ end ~}}
{{~ for slot in accessor.tables ~}}
      @{{ slot.name }} = {{ slot.table_name }}.new
{{~ end ~}}
    end

    # Reads every table from base_path, then links the references between them.
    # Safe to call on a loaded accessor. Every file is read into a table of its own and
    # the references are linked among those, so a failure part way through leaves every
    # table holding the load it already had, and no row points at a row from it.
    def read_all(base_path, file_extension = '{{ accessor.file_extension }}')
{{~ if accessor.tables | array.size == 0 ~}}
      nil
{{~ else ~}}
{{~ for slot in accessor.tables ~}}
      loaded_{{ slot.name }} = {{ slot.table_name }}.new
      loaded_{{ slot.name }}.read(File.join(base_path, "{{ slot.data_file_name }}#{file_extension}"))
{{~ end ~}}

      solve_cross_references({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}loaded_{{ slot.name }}{{ end }})

{{~ for slot in accessor.tables ~}}
      @{{ slot.name }} = loaded_{{ slot.name }}
{{~ end ~}}
{{~ end ~}}
    end

    private

    # Turns the stored indices into usable values, once every table is in memory.
    # The tables arrive as arguments rather than off the instance, which is how this
    # resolves the load being read rather than the one already published.
    def solve_cross_references({{ for slot in accessor.tables }}{{ if !for.first }}, {{ end }}{{ slot.name }}{{ end }})
{{~ if accessor.cross_references | array.size == 0 ~}}
      # No table references another.
      nil
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
      {{ reference.table }}.records.each do |record|
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
        record.{{ field.name }}_index.each_with_index do |index, position|
          target = {{ field.ref_table }}.find(index)
          record.{{ field.name }}[position] = {{ field.value }} unless target.nil?
        end
{{~ else ~}}
        target = {{ field.ref_table }}.find(record.{{ field.name }}_index)
        record.{{ field.name }} = {{ field.value }} unless target.nil?
{{~ end ~}}
{{~ end ~}}
      end
{{~ end ~}}
{{~ end ~}}
    end
  end
{{ include 'ruby-file-foot.sbn' ~}}
