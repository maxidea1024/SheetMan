{{~## One table: its record class and its table class. ##~}}
{{ include 'ruby-file-head.sbn' ~}}
  # Generated from {{ table.location }}
{{~ for line in table.comment ~}}
  # {{ line }}
{{~ end ~}}
  class {{ table.record_name }}
    attr_accessor {{ table.accessor_names }}

    def initialize
{{~ if table.fields | array.size == 0 ~}}
      # No fields.
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ for line in field.initializers ~}}
      {{ line }}
{{~ end ~}}
{{~ end ~}}
    end

  end

  # Every row of {{ table.raw_name }}.
  class {{ table.table_name }}
    attr_accessor :records

    def initialize
      @records = []
{{~ for index in table.indexes ~}}
      {{ index.map_name }} = {}
{{~ end ~}}
    end
{{~ for index in table.indexes }}
    # The row with this {{ index.field_name }}, or nil when the table has none.
    #
    # The lookup to reach for when a missing row is an ordinary answer - an optional
    # reference, a key that came from user input.
    def find_by_{{ index.suffix }}(key)
      {{ index.map_name }}[key]
    end

    # The row with this {{ index.field_name }}, or a raised error naming what was missing.
    #
    # For a key that has to be there - one from another table, or a constant. The name
    # says it raises, because a caller reading `get_by_{{ index.suffix }}(key).name` at a
    # glance cannot otherwise tell whether the next line is a check or a rescue.
    def get_by_{{ index.suffix }}_or_throw(key)
      record = {{ index.map_name }}[key]

      if record.nil?
        raise Sheetman::RecordNotFoundError,
              "there is no record in table `{{ table.raw_name }}` that corresponds to " \
              "field `{{ index.field_name }}` value #{key.inspect}"
      end

      record
    end

    # Whether the table holds a row with this {{ index.field_name }}.
    def contains_{{ index.suffix }}?(key)
      {{ index.map_name }}.key?(key)
    end
{{~ end ~}}

    # Loads the table from a .scb file written by SheetMan.
    # Column by column, matched by tag rather than position: a column this build does
    # not know is skipped by its block length, and one whose type changed incompatibly
    # fails naming the field.
    def read(filename)
      reader = Sheetman::Reader.new(Sheetman.read_all_bytes(filename))
      count, columns = Sheetman.read_table_header(reader)

      # Read into storage of its own and published at the end: reading a table that is already loaded is a refresh, and one that turns out to be unreadable has to leave the rows already there alone.
      records = Array.new(count) { {{ table.record_name }}.new }

      columns.each do |column|
        block_end = reader.position + column.byte_length

        case column.tag
{{~ for field in table.fields ~}}
        when {{ field.tag }}
          {{ field.column_check }}
          records.each do |record|
{{~ if field.kind == 'var_array' ~}}
            element_count = reader.read_counter32
            record.{{ field.name }} = Array.new(element_count) { {{ field.read_element }} }
{{~ else if field.kind == 'serial_ref' ~}}
            record.{{ field.name }}_index = Array.new({{ field.element_count }}) { reader.read_int32 }
            record.{{ field.name }} = Array.new({{ field.element_count }})
{{~ else if field.kind == 'serial' ~}}
            record.{{ field.name }} = Array.new({{ field.element_count }}) { {{ field.read_element }} }
{{~ else if field.kind == 'scalar_ref' ~}}
            record.{{ field.name }}_index = reader.read_int32
{{~ else ~}}
            record.{{ field.name }} = {{ field.read_scalar }}
{{~ end ~}}
          end
{{~ end ~}}
        else
          # A column added after this code was generated.
          reader.skip(column.byte_length)
        end

        Sheetman.check_block_end(reader, column, block_end)
      end

{{~ for index in table.indexes ~}}
      by_{{ index.suffix }} = records.to_h { |record| [record.{{ index.member }}, record] }
{{~ end ~}}

      # Published, now that every column read.
      @records = records
{{~ for index in table.indexes ~}}
      {{ index.map_name }} = by_{{ index.suffix }}
{{~ end ~}}
    end
  end
{{ include 'ruby-file-foot.sbn' ~}}
