{{~##
   One Ruby file: the enums, the constant modules, a record class and a table class per
   table, and the accessor that loads them together.

   Anything needing the model arrives already rendered from RubyView.
##~}}
# ------------------------------------------------------------------------------
# Generated by SheetMan. DO NOT EDIT.
#
# Changes to this file may cause incorrect behavior and will be lost if the code is
# regenerated.
# ------------------------------------------------------------------------------

require_relative 'sheetman/lite_binary_reader'

module {{ module_name }}
{{~ for enumm in enums }}
  # Generated from {{ enumm.location }}
{{~ for line in enumm.comment ~}}
  # {{ line }}
{{~ end ~}}
  module {{ enumm.name }}
{{~ for label in enumm.labels ~}}
{{~ for line in label.comment ~}}
    # {{ line }}
{{~ end ~}}
    {{ label.name }} = {{ label.value }}
{{~ end ~}}

    # Every declared label, by value.
    NAMES = {
{{~ for label in enumm.labels ~}}
      {{ label.value }} => :{{ label.symbol }},
{{~ end ~}}
    }.freeze

    # The label's name, or nil when the sheet declared no such value.
    def self.name_of(value)
      NAMES[value]
    end
  end
{{~ end ~}}
{{~ for set in constant_sets }}
  # Generated from {{ set.location }}
{{~ for line in set.comment ~}}
  # {{ line }}
{{~ end ~}}
  module {{ set.name }}
{{~ for constant in set.constants ~}}
{{~ for line in constant.comment ~}}
    # {{ line }}
{{~ end ~}}
    {{ constant.name }} = {{ constant.value }}
{{~ end ~}}
  end
{{~ end ~}}
{{~ for table in tables }}
  # Generated from {{ table.location }}
{{~ for line in table.comment ~}}
  # {{ line }}
{{~ end ~}}
  class {{ table.record_name }}
    attr_accessor {{ table.accessor_names }}

    def initialize
{{~ if table.fields | array.size == 0 ~}}
      # No fields.
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ for line in field.initializers ~}}
      {{ line }}
{{~ end ~}}
{{~ end ~}}
    end

    # Reads one record, in the exact field order the exporter wrote.
    def read(reader)
{{~ if table.fields | array.size == 0 ~}}
      nil
{{~ end ~}}
{{~ for field in table.fields ~}}
{{~ if field.kind == 'var_array' ~}}
      count = reader.read_counter32
      @{{ field.name }} = Array.new(count) { {{ field.read_element }} }
{{~ else if field.kind == 'serial_ref' ~}}
      @{{ field.name }}_index = Array.new({{ field.element_count }}) { reader.read_int32 }
      @{{ field.name }} = Array.new({{ field.element_count }})
{{~ else if field.kind == 'serial' ~}}
      @{{ field.name }} = Array.new({{ field.element_count }}) { {{ field.read_element }} }
{{~ else if field.kind == 'scalar_ref' ~}}
      @{{ field.name }}_index = reader.read_int32
{{~ else ~}}
      @{{ field.name }} = {{ field.read_scalar }}
{{~ end ~}}
{{~ end ~}}
    end
  end

  # Every row of {{ table.raw_name }}.
  class {{ table.table_name }}
    attr_reader :records

    def initialize
      @records = []
      @by_index = {}
    end

    # The row with the given primary index, or nil when there is none.
    def find(index)
      @by_index[index]
    end

    # Loads the table from a .table file written by SheetMan.
    def read(filename)
      reader = Sheetman::Reader.new(Sheetman.read_all_bytes(filename))
      count = Sheetman.read_table_header(reader)

      @records = Array.new(count) do
        record = {{ table.record_name }}.new
        record.read(reader)
        record
      end

      @by_index = @records.to_h { |record| [record.{{ table.index_field }}, record] }
    end
  end
{{~ end }}
  # Every table, loaded together so cross-table references can be resolved.
  class Tables
    attr_reader {{ accessor.reader_names }}

    def initialize
{{~ if accessor.tables | array.size == 0 ~}}
      nil
{{~ end ~}}
{{~ for slot in accessor.tables ~}}
      @{{ slot.name }} = {{ slot.table_name }}.new
{{~ end ~}}
    end

    # Reads every table from base_path, then links the references between them.
    def read_all(base_path)
{{~ if accessor.tables | array.size == 0 ~}}
      nil
{{~ else ~}}
{{~ for slot in accessor.tables ~}}
      @{{ slot.name }}.read(File.join(base_path, '{{ slot.data_file_name }}{{ accessor.file_extension }}'))
{{~ end ~}}

      solve_cross_references
{{~ end ~}}
    end

    private

    # Turns the stored indices into usable values, once every table is in memory.
    def solve_cross_references
{{~ if accessor.cross_references | array.size == 0 ~}}
      # No table references another.
      nil
{{~ else ~}}
{{~ for reference in accessor.cross_references ~}}
      @{{ reference.table }}.records.each do |record|
{{~ for field in reference.fields ~}}
{{~ if field.is_array ~}}
        record.{{ field.name }}_index.each_with_index do |index, position|
          target = @{{ field.ref_table }}.find(index)
          record.{{ field.name }}[position] = {{ field.value }} unless target.nil?
        end
{{~ else ~}}
        target = @{{ field.ref_table }}.find(record.{{ field.name }}_index)
        record.{{ field.name }} = {{ field.value }} unless target.nil?
{{~ end ~}}
{{~ end ~}}
      end
{{~ end ~}}
{{~ end ~}}
    end
  end
end
