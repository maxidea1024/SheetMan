{{~## The accessor, holding no table's own code. ##~}}
{{ include 'rust-file-head.sbn' ~}}
/// Every table, loaded together.
#[derive(Clone, Debug, Default)]
pub struct Tables {
{{~ for slot in accessor.tables ~}}
    pub {{ slot.name }}: {{ slot.table_name }},
{{~ end ~}}
}

impl Tables {
    /// Reads every table from `base_path`.
    ///
    /// The data files are expected to carry the extension the recipe told the exporter to
    /// write. Use `read_all_with_extension` to name a different one.
    pub fn read_all(&mut self, base_path: &Path) -> sheetman::Result<()> {
        self.read_all_with_extension(base_path, "{{ accessor.file_extension }}")
    }

    /// The same, for data files that carry some other extension.
    ///
    /// Safe to call on a loaded `Tables`. Every file is read into a set of its own, so `?`
    /// on an unreadable one returns before anything is replaced and leaves the tables
    /// holding the load they already had.
    pub fn read_all_with_extension(
        &mut self, base_path: &Path, file_extension: &str) -> sheetman::Result<()> {
{{~ if accessor.tables | array.size == 0 ~}}
        let _ = base_path;
        let _ = file_extension;
{{~ else ~}}
        let mut loaded = Tables::default();

{{~ for slot in accessor.tables ~}}
        loaded.{{ slot.name }}.read(
            &base_path.join(format!("{{ slot.data_file_name }}{}", file_extension)))?;
{{~ end ~}}

        *self = loaded;
{{~ end ~}}

        Ok(())
    }
}
