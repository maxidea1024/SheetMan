{{~## One table: its record struct and its table type. ##~}}
{{ include 'rust-file-head.sbn' ~}}
// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
#[derive(Clone, Debug, Default)]
pub struct {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    pub {{ declaration }}
{{~ end ~}}
{{~ end ~}}
}

impl {{ table.record_name }} {
    /// Reads one record, in the exact field order the exporter wrote.
    fn read(reader: &mut sheetman::Reader<'_>) -> sheetman::Result<Self> {
        Ok({{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ if field.kind == 'var_array' ~}}
            {{ field.name }}: {
                let count = reader.read_counter32()?;
                let mut values = Vec::with_capacity(count.max(0) as usize);
                for _ in 0..count {
                    values.push({{ field.read_element }});
                }
                values
            },
{{~ else if field.kind == 'serial_ref' ~}}
            {{ field.name }}_index: {
                let mut values = Vec::with_capacity({{ field.element_count }});
                for _ in 0..{{ field.element_count }} {
                    values.push(reader.read_i32()?);
                }
                values
            },
{{~ else if field.kind == 'serial' ~}}
            {{ field.name }}: {
                let mut values = Vec::with_capacity({{ field.element_count }});
                for _ in 0..{{ field.element_count }} {
                    values.push({{ field.read_element }});
                }
                values
            },
{{~ else if field.kind == 'scalar_ref' ~}}
            {{ field.name }}_index: reader.read_i32()?,
{{~ else ~}}
            {{ field.name }}: {{ field.read_scalar }},
{{~ end ~}}
{{~ end ~}}
        })
    }
}

/// Every row of {{ table.raw_name }}.
#[derive(Clone, Debug, Default)]
pub struct {{ table.table_name }} {
    records: Vec<{{ table.record_name }}>,
    by_index: HashMap<i32, usize>,
}

impl {{ table.table_name }} {
    /// Every row, in the order the sheet declared them.
    pub fn records(&self) -> &[{{ table.record_name }}] {
        &self.records
    }

    /// The row with the given primary index, or None when there is none.
    pub fn find(&self, index: i32) -> Option<&{{ table.record_name }}> {
        self.by_index.get(&index).map(|position| &self.records[*position])
    }

    /// Loads the table from a .table file written by SheetMan.
    pub fn read(&mut self, filename: &Path) -> sheetman::Result<()> {
        let data = sheetman::read_all_bytes(filename)?;
        let mut reader = sheetman::Reader::new(&data);

        let count = sheetman::read_table_header(&mut reader)?;

        self.records = Vec::with_capacity(count.max(0) as usize);
        for _ in 0..count {
            self.records.push({{ table.record_name }}::read(&mut reader)?);
        }

        self.by_index = self
            .records
            .iter()
            .enumerate()
            .map(|(position, record)| (record.{{ table.index_field }}, position))
            .collect();

        Ok(())
    }
}
