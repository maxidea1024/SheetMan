{{~## One table: its record struct and its table type. ##~}}
{{ include 'rust-file-head.sbn' ~}}
// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/// {{ line }}
{{~ end ~}}
#[derive(Clone, Debug, Default)]
pub struct {{ table.record_name }} {
{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /// {{ line }}
{{~ end ~}}
{{~ for declaration in field.declarations ~}}
    pub {{ declaration }}
{{~ end ~}}
{{~ end ~}}
}

impl {{ table.record_name }} {
}

/// Every row of {{ table.raw_name }}.
#[derive(Clone, Debug, Default)]
pub struct {{ table.table_name }} {
    records: Vec<{{ table.record_name }}>,
{{~ for index in table.indexes ~}}
    {{ index.map_name }}: HashMap<{{ index.key_type }}, usize>,
{{~ end ~}}
}

impl {{ table.table_name }} {
    /// Every row, in the order the sheet declared them.
    pub fn records(&self) -> &[{{ table.record_name }}] {
        &self.records
    }
{{~ for index in table.indexes }}
    /// The row with this {{ index.field_name }}, or None when the table has none.
    ///
    /// The lookup to reach for when a missing row is an ordinary answer - an optional
    /// reference, a key that came from user input.
    pub fn find_by_{{ index.suffix }}(&self, key: {{ index.key_param }}) -> Option<&{{ table.record_name }}> {
        self.{{ index.map_name }}.get({{ index.key_borrow }}).map(|position| &self.records[*position])
    }

    /// The row with this {{ index.field_name }}, or an error naming what was missing.
    ///
    /// For a key that has to be there - one from another table, or a constant. Rust has no
    /// exception to throw, so where the other languages name a throw this one names the
    /// error it returns.
    pub fn get_by_{{ index.suffix }}_or_error(&self, key: {{ index.key_param }}) -> sheetman::Result<&{{ table.record_name }}> {
        self.{{ index.map_name }}
            .get({{ index.key_borrow }})
            .map(|position| &self.records[*position])
            .ok_or_else(|| sheetman::Error::RecordNotFound {
                table: "{{ table.raw_name }}",
                field: "{{ index.field_name }}",
                key: format!("{:?}", key),
            })
    }

    /// Whether the table holds a row with this {{ index.field_name }}.
    pub fn contains_{{ index.suffix }}(&self, key: {{ index.key_param }}) -> bool {
        self.{{ index.map_name }}.contains_key({{ index.key_borrow }})
    }
{{~ end ~}}

    /// Loads the table from a .scb file written by SheetMan.
    pub fn read(&mut self, filename: &Path) -> sheetman::Result<()> {
        let data = sheetman::read_all_bytes(filename)?;
        let mut reader = sheetman::Reader::new(&data);

        // Column by column, matched by tag rather than position: a column this build
        // does not know is skipped by its block length, and one whose type changed
        // incompatibly fails naming the field.
        let header = sheetman::read_table_header(&mut reader)?;
        let count = header.row_count.max(0) as usize;

        // Read into rows of its own and assigned at the end. Reading a table that is
        // already loaded is a refresh, and one that turns out to be unreadable has to
        // leave the rows already there alone - `?` returns before anything is replaced.
        let mut records = vec![{{ table.record_name }}::default(); count];

        for column in &header.columns {
            let block_end = reader.position() + column.byte_length.max(0) as usize;

            match column.tag {
{{~ for field in table.fields ~}}
                {{ field.tag }} => {
                    {{ field.column_check }}
                    for record in records.iter_mut() {
{{~ if field.kind == 'var_array' ~}}
                        let element_count = reader.read_counter32()?.max(0) as usize;
                        record.{{ field.name }} = Vec::with_capacity(element_count.min(65536));
                        for _ in 0..element_count {
                            record.{{ field.name }}.push({{ field.read_element }});
                        }
{{~ else if field.kind == 'serial_ref' ~}}
                        record.{{ field.name }}_index = Vec::with_capacity({{ field.element_count }});
                        for _ in 0..{{ field.element_count }} {
                            record.{{ field.name }}_index.push(reader.read_i32()?);
                        }
{{~ else if field.kind == 'serial' ~}}
                        record.{{ field.name }} = Vec::with_capacity({{ field.element_count }});
                        for _ in 0..{{ field.element_count }} {
                            record.{{ field.name }}.push({{ field.read_element }});
                        }
{{~ else if field.kind == 'scalar_ref' ~}}
                        record.{{ field.name }}_index = reader.read_i32()?;
{{~ else ~}}
                        record.{{ field.name }} = {{ field.read_scalar }};
{{~ end ~}}
                    }
                }
{{~ end ~}}
                _ => {
                    // A column added after this code was generated.
                    reader.skip(column.byte_length)?;
                }
            }

            sheetman::check_block_end(&reader, column, block_end)?;
        }

{{~ for index in table.indexes ~}}
        let {{ index.map_name }} = records
            .iter()
            .enumerate()
            .map(|(position, record)| (record.{{ index.member }}.clone(), position))
            .collect();

{{~ end ~}}
        // Published, now that every column read.
        self.records = records;
{{~ for index in table.indexes ~}}
        self.{{ index.map_name }} = {{ index.map_name }};
{{~ end ~}}

        Ok(())
    }
}
