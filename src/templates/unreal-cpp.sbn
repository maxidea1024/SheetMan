{{~ for field in table.fields ~}}
{{~ if field.kind == 'var_array' ~}}
    {
        int32 {{ field.count_local }} = 0;
        Reader.ReadCounter32({{ field.count_local }});

        // Bounded, because the count came out of the file. The array grows past this
        // if the elements really are there.
        {{ field.name }}.Empty(SheetMan::ReserveBound({{ field.count_local }}));

        while ({{ field.name }}.Num() < {{ field.count_local }} && !Reader.HasFailed())
        {
            Reader.{{ field.read_call }}({{ field.name }}.AddDefaulted_GetRef());
        }
    }
{{~ else if field.kind == 'serial_ref' ~}}
    {{ field.name }}Index.Empty({{ field.element_count }});
    while ({{ field.name }}Index.Num() < {{ field.element_count }})
    {
        Reader.Read({{ field.name }}Index.AddDefaulted_GetRef());
    }
{{~ else if field.kind == 'serial' ~}}
    {{ field.name }}.Empty({{ field.element_count }});
    while ({{ field.name }}.Num() < {{ field.element_count }})
    {
        Reader.{{ field.read_call }}({{ field.name }}.AddDefaulted_GetRef());
    }
{{~ else if field.kind == 'scalar_ref' ~}}
    Reader.Read({{ field.name }}Index);
{{~ else ~}}
    Reader.{{ field.read_call }}({{ field.name }});
{{~ end ~}}
{{~ end ~}}
}
{{~ end ~}}
