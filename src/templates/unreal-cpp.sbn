const {{ table.record_name }}* {{ table.table_name }}::FindBy{{ index.suffix }}({{ index.key_param }} Key) const
{
    const int32* Position = {{ index.map_name }}.Find(Key);
    return Position != nullptr ? &RecordsStorage[*Position] : nullptr;
}

bool {{ table.table_name }}::Contains{{ index.suffix }}({{ index.key_param }} Key) const
{
    return {{ index.map_name }}.Contains(Key);
}

