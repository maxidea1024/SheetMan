bool {{ table.table_name }}::Read(const FString& Filename)
{
    TArray<uint8> Buffer;
    if (!FFileHelper::LoadFileToArray(Buffer, *Filename))
    {
        UE_LOG(LogTemp, Error, TEXT("SheetMan: could not read %s"), *Filename);
        return false;
    }

    // Pointer and length, so the file is read once and not copied into a vector as
    // well - a localization table is megabytes.
    sheetman::LiteBinaryReader Reader(Buffer.GetData(), static_cast<std::size_t>(Buffer.Num()));

    const std::int32_t RowCount = sheetman::read_table_header(Reader);

    RecordsStorage.Empty(RowCount);
    for (std::int32_t Row = 0; Row < RowCount; ++Row)
    {
        {{ table.record_name }}& Record = RecordsStorage.AddDefaulted_GetRef();
        Record.Read(Reader);
    }

    ByIndex.Empty(RecordsStorage.Num());
    for (int32 Position = 0; Position < RecordsStorage.Num(); ++Position)
    {
        ByIndex.Add(RecordsStorage[Position].{{ table.index_field }}, Position);
    }

    return true;
}
