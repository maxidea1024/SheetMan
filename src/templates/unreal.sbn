{{~##
   An Unreal module: one header of USTRUCTs and UENUMs, and a static accessor class.

   Two things Unreal Header Tool insists on and a template can get wrong silently:

     the .generated.h include must be last, after every other include, or UHT emits a
     diagnostic that names the wrong line;

     a BlueprintType enum's underlying type must be uint8, which is why the generator
     refuses a sheet whose enum values fall outside 0 to 255 rather than emitting a
     header that fails deep inside UHT.

   There is no conversion namespace here any more. The reader fills engine types
   directly, so there is nothing left to convert between.

   Anything needing the model arrives already rendered from UnrealView.
##~}}
// ------------------------------------------------------------------------------
// Generated by SheetMan. DO NOT EDIT.
//
// Changes to this file may cause incorrect behavior and will be lost if the code is
// regenerated.
// ------------------------------------------------------------------------------

#pragma once

#include "CoreMinimal.h"
#include "UObject/ObjectMacros.h"
#include "Kismet/BlueprintFunctionLibrary.h"

#include "SheetManLiteBinaryReader.h"

// Must be the last include. UHT requires it, and moving it produces an error that
// names some other line entirely.
#include "{{ accessor_name }}.generated.h"
{{~ for enumm in enums }}

// Generated from {{ enumm.location }}
{{~ for line in enumm.comment ~}}
/** {{ line }} */
{{~ end ~}}
{{~ if enumm.blueprint_visible ~}}
UENUM(BlueprintType)
{{~ else ~}}
// Not BlueprintType: {{ enumm.not_visible_because }} Still a UENUM, so it is reflected and
// serialises; it is only Blueprint that cannot see it, and neither can the fields using it.
UENUM()
{{~ end ~}}
enum class {{ enumm.name }} : {{ enumm.underlying_type }}
{
{{~ for label in enumm.labels ~}}
{{~ for line in label.comment ~}}
    /** {{ line }} */
{{~ end ~}}
    {{ label.name }} = {{ label.value }} UMETA(DisplayName = "{{ label.display_name }}"),
{{~ end ~}}
};
{{~ end ~}}
{{~ for table in tables }}

// Generated from {{ table.location }}
{{~ for line in table.comment ~}}
/** {{ line }} */
{{~ end ~}}
USTRUCT(BlueprintType)
struct {{ api_macro }} {{ table.record_name }}
{
    GENERATED_BODY()

{{~ for field in table.fields ~}}
{{~ for line in field.comment ~}}
    /** {{ line }} */
{{~ end ~}}
{{~ if field.blueprint_visible ~}}
    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "{{ table.raw_name }}")
{{~ else ~}}
    // No UPROPERTY: {{ field.not_visible_because }}
{{~ end ~}}
    {{ field.declaration }}

{{~ end ~}}};
{{~ end ~}}
{{~ for table in tables }}

/** Every row of {{ table.raw_name }}. */
class {{ api_macro }} {{ table.table_name }}
{
public:
    const TArray<{{ table.record_name }}>& Records() const { return RecordsStorage; }

    /** The row with the given primary index, or nullptr when there is none. */
    const {{ table.record_name }}* Find(int32 Index) const;

    /** Loads the table from a .table file written by SheetMan. */
    bool Read(const FString& Filename);

private:
    TArray<{{ table.record_name }}> RecordsStorage;
    TMap<int32, int32> ByIndex;
};
{{~ end }}

/**
 * Every table, loaded together.
 *
 * A static class rather than a UObject: the data outlives any world, is read once at
 * startup and never mutated, and nothing here needs reflection or garbage collection.
 */
class {{ api_macro }} {{ accessor_name }}
{
public:
{{~ for slot in accessor.tables ~}}
    static const {{ slot.table_name }}& {{ slot.name }}() { return {{ slot.name }}Storage; }
{{~ end ~}}

    /**
     * Reads every table from BasePath. Returns false if any of them could not be read.
     *
     * FileExtension defaults to what the recipe told the exporter to write. Pass a different
     * one when the data files were renamed on the way into the package - which they often are,
     * since some platforms only cook what carries an extension they recognise.
     */
    static bool ReadAll(const FString& BasePath,
                        const FString& FileExtension = TEXT("{{ accessor.file_extension }}"));

private:
{{~ for slot in accessor.tables ~}}
    static {{ slot.table_name }} {{ slot.name }}Storage;
{{~ end ~}}
};

/**
 * The same data, reachable from Blueprint.
 *
 * Every row above is a USTRUCT marked BlueprintType with BlueprintReadOnly properties,
 * which says the rows are meant to be used from Blueprint - and until this existed there
 * was no way to get one. A graph could declare a variable of a row type and had nothing to
 * obtain a value from, because the accessor is a plain C++ class and a static method on one
 * is not something Blueprint can call.
 *
 * A function library rather than making the accessor a UObject. The storage stays where it
 * is: this owns nothing, adds no garbage collection, and does not need a world. It is a
 * few UFUNCTIONs over the C++ that was already there.
 */
UCLASS()
class {{ api_macro }} {{ accessor.library_name }} : public UBlueprintFunctionLibrary
{
    GENERATED_BODY()

public:
{{~ for slot in accessor.tables }}
    /**
     * The {{ slot.raw_name }} row with the given primary index.
     *
     * bFound rather than a pointer, because Blueprint has no null struct - a graph that
     * ignored a failure would otherwise carry a default row it could not tell apart from
     * a real one.
     */
    UFUNCTION(BlueprintPure, Category = "SheetMan|{{ slot.raw_name }}",
              meta = (DisplayName = "Get {{ slot.raw_name }} Row"))
    static {{ slot.record_name }} Get{{ slot.name }}Row(int32 Index, bool& bFound);

    /** How many {{ slot.raw_name }} rows were loaded. */
    UFUNCTION(BlueprintPure, Category = "SheetMan|{{ slot.raw_name }}",
              meta = (DisplayName = "Get {{ slot.raw_name }} Row Count"))
    static int32 Get{{ slot.name }}RowCount();

    /**
     * The {{ slot.raw_name }} row at a position, for walking the table in order.
     *
     * A position and a count rather than the whole array. Blueprint takes a return value
     * by value, so handing back a TArray would copy every row of the table on every call -
     * and a reference return is not something Unreal Header Tool accepts. With these two a
     * graph can loop over the table and copy one row per turn.
     */
    UFUNCTION(BlueprintPure, Category = "SheetMan|{{ slot.raw_name }}",
              meta = (DisplayName = "Get {{ slot.raw_name }} Row At"))
    static {{ slot.record_name }} Get{{ slot.name }}RowAt(int32 Position, bool& bFound);
{{~ end }}
    /**
     * Reads every table from BasePath, as {{ accessor_name }}::ReadAll does.
     *
     * BlueprintCallable rather than BlueprintPure: it does something.
     */
    UFUNCTION(BlueprintCallable, Category = "SheetMan",
              meta = (DisplayName = "Load All SheetMan Tables"))
    static bool ReadAll(const FString& BasePath,
                        const FString& FileExtension = TEXT("{{ accessor.file_extension }}"));
};
{{~ if accessor.tables | array.size == 0 }}
{{~ end ~}}
