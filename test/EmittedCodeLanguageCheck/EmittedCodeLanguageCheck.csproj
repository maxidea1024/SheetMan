<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This project builds nothing anyone ships. It exists so the compiler enforces the
      language ceiling on the reader that SheetMan emits into its C# output.

      That reader ends up in Unity projects, and the oldest Unity this supports is
      2020.3, which accepts C# 8. netstandard2.1 defaults to exactly that LangVersion,
      so anything newer fails here rather than in somebody's game project - which is
      where it would otherwise surface, since nothing in this repository compiles the
      emitted file otherwise.

      It used to serve the same purpose for the LiteBinary runtime that the exporter and
      the generated code both borrowed from the Unity plugin. That sharing is gone - the
      exporter carries its own writer and the generated code carries its own reader - so
      only the emitted reader still needs guarding, and the project moved here from
      ../runtime because a folder by that name suggests something ships from it.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SheetMan.Binary</RootNamespace>
    <AssemblyName>EmittedCodeLanguageCheck</AssemblyName>

    <!-- Nothing consumes the assembly; only the compile has to succeed. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The same file the generator embeds and writes into its output, compiled from where
      it lives rather than copied, so the check cannot go stale.
    -->
    <Compile Include="..\..\lib\cs\sheetman\LiteBinaryReader.cs"
             Link="LiteBinaryReader.cs" />
  </ItemGroup>

</Project>
