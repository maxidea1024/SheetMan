{
  // The same outputs as core.json, expressed through the `Targets` list instead of
  // the named recipe sections.
  //
  // Every setting is identical, including the namespaces and accessor names that end
  // up inside the generated files, and only the output root differs. So this tree has
  // to match core's golden tree byte for byte - which is what the test asserts, and a
  // stronger statement than checking that a few fields came through.
  //
  // `Type` picks the target by its registered id; the rest of each object is that
  // target's own settings, the same fields its dedicated section takes.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/core",
        "FileExtensionPatterns": ".xlsx"
      }
    ]
  },

  "Targets": [
    {
      "Type": "binary",
      "Path": "test/fixtures/output/core-dynamic/binary",
      "FileExtension": ".table"
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-dynamic/json-compact",
      "UseCompactRowFormat": true,
      "Indented": true
    },
    {
      "Type": "json",
      "Path": "test/fixtures/output/core-dynamic/json-named",
      "UseCompactRowFormat": false,
      "Indented": true
    },
    {
      "Type": "cpp",
      "Path": "test/fixtures/output/core-dynamic/cpp",
      "Namespace": "sheetman_fixtures::core",
      "AccessorName": "CoreAccessor",
      "BinaryTableFileExtension": ".table"
    },
    {
      "Type": "csharp",
      "Path": "test/fixtures/output/core-dynamic/csharp",
      "Namespace": "SheetMan.Fixtures.Core",
      "AccessorName": "CoreAccessor"
    },
    {
      "Type": "typescript",
      "Path": "test/fixtures/output/core-dynamic/typescript"
    },
    {
      "Type": "html",
      "Path": "test/fixtures/output/core-dynamic/html"
    },
    {
      "Type": "summary",
      "Path": "test/fixtures/output/core-dynamic/summary"
    }
  ]
}
