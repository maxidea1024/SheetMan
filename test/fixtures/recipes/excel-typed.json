{
  // Regression recipe for the `core.xlsx` fixture.
  //
  // Every path is relative to the repository root, which is where the test
  // harness invokes SheetMan from. Output lands in test/fixtures/output/excel-typed
  // (transient, gitignored) and is compared against test/fixtures/golden/core.
  //
  // Both JSON row formats are exported because they take different code paths
  // in JsonExporter and only the compact one is currently correct.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/excel-typed",
        "FileExtensionPatterns": ".xlsx"
      }
    ],
    "GoogleSheets": []
  },

  "Exports": {
    "Binary": [
      {
        "Path": "test/fixtures/output/excel-typed/binary",
        "FileExtension": ".table"
      }
    ],
    "Json": [
      {
        "Path": "test/fixtures/output/excel-typed/json-compact",
        "UseCompactRowFormat": true,
        "Indented": true
      },
      {
        "Path": "test/fixtures/output/excel-typed/json-named",
        "UseCompactRowFormat": false,
        "Indented": true
      }
    ],
    "MongoDb": [],
    "MySql": []
  },

  "CodeGenerations": {
    "Cpp": [],
    "CSharp": [
      {
        "Path": "test/fixtures/output/excel-typed/csharp",
        "Namespace": "SheetMan.Fixtures.X",
        "AccessorName": "XAccessor"
      }
    ],
    "Typescript": [
      {
        "Path": "test/fixtures/output/excel-typed/typescript"
      }
    ],
    "Html": [
      {
        "Path": "test/fixtures/output/excel-typed/html"
      }
    ]
  }
}
