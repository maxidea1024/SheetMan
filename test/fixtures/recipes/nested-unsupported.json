{
  // The same workbook as `nested`, with a target that has not learned what a record is.
  //
  // Expected to fail, and that is the point: such a target must say so by name rather
  // than reach for the single column a record group does not have.
  //
  // It named `csharp` until csharp learned, at which point this test stopped failing and
  // said so - so when the target here starts supporting records, move it to another one
  // that does not. Delete the recipe when the last one lands.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/nested",
        "FileExtensionPatterns": ".xlsx"
      }
    ],
    "GoogleSheets": []
  },

  // Go has no recipe section of its own - the targets added since the `Targets` list
  // exists are reached only through it - so it is named here by type.
  "Targets": [
    {
      "Type": "go",
      "Path": "test/fixtures/output/nested-unsupported/go",
      "PackageName": "nested",
      "ModulePath": "nested"
    }
  ]
}
