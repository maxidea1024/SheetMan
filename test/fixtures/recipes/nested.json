{
  // The `Group.Member` notation converted end to end, as far as it goes today.
  //
  // JSON only, deliberately. It is the one consumer that carries a record without a
  // type system to teach first, so it is what makes the notation observable while the
  // generators are still being converted one language at a time. Adding a code target
  // here would fail by design - see spec/nested-fields.md - and the refusal is covered
  // by its own test rather than by this recipe.
  //
  // Both row formats, because they take different paths: the named one nests, and the
  // compact one is positional over the columns and therefore stays flat. Both are
  // correct and the golden holds them to it.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/nested",
        "FileExtensionPatterns": ".xlsx"
      }
    ],
    "GoogleSheets": []
  },

  "Exports": {
    "Json": [
      {
        "Path": "test/fixtures/output/nested/json-compact",
        "UseCompactRowFormat": true,
        "Indented": true
      },
      {
        "Path": "test/fixtures/output/nested/json-named",
        "UseCompactRowFormat": false,
        "Indented": true
      }
    ],
    "MongoDb": [],
    "MySql": []
  }
}
