{
  // The `Group.Member` notation converted end to end, as far as it goes today.
  //
  // No code targets yet, deliberately: each one refuses a record until it learns the
  // shape, which is by design and covered by NestedTargetSupportTests rather than here.
  // Add them to this recipe as they land.
  //
  // Both JSON row formats, because they take different paths: the named one nests, and
  // the compact one is positional over the columns and therefore stays flat. Both are
  // correct and the golden holds them to it.
  //
  // Binary, because a record group's members are separate columns in the file - one
  // fixed-array column each - and the descriptors are what say so. The golden holds the
  // bytes, so a change to how a record is laid out cannot pass unnoticed.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/nested",
        "FileExtensionPatterns": ".xlsx"
      }
    ],
    "GoogleSheets": []
  },

  "CodeGenerations": {
    "CSharp": [
      {
        "Path": "test/fixtures/output/nested/csharp",
        "Namespace": "SheetMan.Fixtures.Nested",
        "AccessorName": "NestedAccessor"
      }
    ]
  },

  "Exports": {
    "Binary": [
      {
        "Path": "test/fixtures/output/nested/binary",
        "FileExtension": ".scb"
      }
    ],
    "Json": [
      {
        "Path": "test/fixtures/output/nested/json-compact",
        "UseCompactRowFormat": true,
        "Indented": true
      },
      {
        "Path": "test/fixtures/output/nested/json-named",
        "UseCompactRowFormat": false,
        "Indented": true
      }
    ],
    "MongoDb": [],
    "MySql": []
  }
}
