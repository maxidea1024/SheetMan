{
  // Identifiers that collide with a keyword in one of the output languages.
  //
  // All three code generators plus the binary export, because the question - does an
  // identifier taken from a sheet survive into compilable code - is answered by
  // compiling, not by reading the generators.

  "Sources": {
    "Xlsx": [
      {
        "Path": "test/fixtures/xlsx/reserved-words",
        "FileExtensionPatterns": ".xlsx"
      }
    ]
  },

  "Exports": {
    "Binary": [
      {
        "Path": "test/fixtures/output/reserved-words/binary",
        "FileExtension": ".table"
      }
    ],
    "Json": [
      {
        "Path": "test/fixtures/output/reserved-words/json-named",
        "UseCompactRowFormat": false,
        "Indented": true
      }
    ]
  },

  // The seven languages that have no section of their own. Every one of them is
  // compiled from this fixture: what a generator does with a name that collides with a
  // keyword is a question only a compiler can answer, and the three that were checked
  // here before were the three whose answer somebody had already guessed at.
  "Targets": [
    { "Type": "go", "Path": "test/fixtures/output/reserved-words/go",
      "PackageName": "reserved", "ModulePath": "reserved" },
    { "Type": "rust", "Path": "test/fixtures/output/reserved-words/rust",
      "CrateName": "reserved" },
    { "Type": "python", "Path": "test/fixtures/output/reserved-words/python",
      "PackageName": "reserved" },
    { "Type": "java", "Path": "test/fixtures/output/reserved-words/java",
      "PackageName": "reserved", "AccessorName": "ReservedAccessor" },
    { "Type": "kotlin", "Path": "test/fixtures/output/reserved-words/kotlin",
      "PackageName": "reserved", "AccessorName": "ReservedAccessor" },
    { "Type": "ruby", "Path": "test/fixtures/output/reserved-words/ruby",
      "ModuleName": "Reserved", "AccessorName": "sheetman_data" },
    { "Type": "dart", "Path": "test/fixtures/output/reserved-words/dart",
      "AccessorName": "sheetman_data" },
    { "Type": "c", "Path": "test/fixtures/output/reserved-words/c",
      "AccessorName": "ReservedData" },
    { "Type": "php", "Path": "test/fixtures/output/reserved-words/php",
      "Namespace": "Reserved", "AccessorName": "ReservedData" },

    // Not for the names - the documentation escapes nothing, so a keyword is just a word
    // here. It is here because this model declares no enum and no constant set, and the
    // index page's empty columns had no test on them. Three golden trees had been recording
    // the empty list as correct.
    { "Type": "html", "Path": "test/fixtures/output/reserved-words/html" }
  ],

  "CodeGenerations": {
    "Cpp": [
      {
        "Path": "test/fixtures/output/reserved-words/cpp",
        "Namespace": "sheetman_fixtures::reserved",
        "AccessorName": "ReservedAccessor",
        "BinaryTableFileExtension": ".table"
      }
    ],
    "CSharp": [
      {
        "Path": "test/fixtures/output/reserved-words/csharp",
        "Namespace": "SheetMan.Fixtures.Reserved",
        "AccessorName": "ReservedAccessor"
      }
    ],
    "Typescript": [
      {
        "Path": "test/fixtures/output/reserved-words/typescript"
      }
    ]
  }
}
