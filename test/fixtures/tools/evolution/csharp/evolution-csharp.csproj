<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the skew harness against one generation's generated C#. The data directory is
    an argument rather than a property, which is the whole point: the same build reads its
    own generation's files and the other's.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>evolution-csharp</AssemblyName>
    <RootNamespace>SheetMan.Evolution.Harness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Selects the non-Unity branches of the generated code, as a non-Unity consumer would. -->
    <DefineConstants>$(DefineConstants);NO_UNITY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedDir)\**\*.cs" />
  </ItemGroup>

</Project>
